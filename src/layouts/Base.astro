---
import "../styles/global.css";
import { BRAND, DIG, SUPPORT, DISCOGS_ATTRIBUTION } from "../config/brand";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  headerVariant?: "standard" | "overlay";
}

const { title, description, bodyClass, headerVariant = "standard" } = Astro.props;
const path = Astro.url.pathname;
const canonicalUrl = new URL(path, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL("/social/woiii-social-card.png", Astro.site ?? Astro.url.origin);
const socialImageAlt = "Which pressing is actually worth buying? Shown above a row of album covers.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link
      rel="preload"
      href="/fonts/GT-Standard-L-Regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={["site-header", { "site-header-overlay": headerVariant === "overlay" }]}>
      <div class="wrap header-row">
        <a class="wordmark" href="/" aria-label="WOIII.me home">
          <img src="/woiii-logo.svg" alt="" width="108" height="32" />
        </a>
        <nav aria-label="Main">
          <a href="/#why-dig">Why .DIG</a>
          <a href="/#journey">How it works</a>
          <a href="/#products">Products</a>
          <a class="header-connect-button" href="/connect" aria-current={path.startsWith("/connect") ? "page" : undefined}>Connect guide</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer
      id="site-footer"
      class:list={["site-footer", { "site-footer-light": path === "/" }]}
      data-header-tone={path === "/" ? "light" : "dark"}
    >
      <div class="wrap footer-inner">
        <div class="footer-links">
          <div>
            <h2 class="footer-heading">woiii.me/DIG for Discogs</h2>
            <ul>
              <li><a href="/connect">Connection guide</a></li>
              <li><a href={DIG.repoUrl} target="_blank" rel="noopener noreferrer">Source code</a> <span class="footer-note">MIT</span></li>
              <li><a href={DIG.releasesUrl} target="_blank" rel="noopener noreferrer">Releases</a></li>
            </ul>
          </div>
          <div id="support">
            <h2 class="footer-heading">Support</h2>
            <ul>
              <li><a href={`mailto:${SUPPORT.email}`}>{SUPPORT.email}</a></li>
              <li><a href={DIG.issuesUrl} target="_blank" rel="noopener noreferrer">GitHub issues</a></li>
              <li><a href={DIG.discussionsUrl} target="_blank" rel="noopener noreferrer">Discussions</a></li>
            </ul>
          </div>
        </div>

        <p class="footer-tagline">AI-powered tools for <em>music lovers</em></p>

        <div class="footer-lower">
          <div class="footer-mega-logo" aria-hidden="true">
            <img src="/woiii-logo.svg" alt="" width="108" height="32" />
          </div>
          <div class="footer-meta">
            <p>{DISCOGS_ATTRIBUTION}</p>
            <div class="footer-meta-row">
              <p>© {new Date().getFullYear()} {BRAND.publisher}</p>
              <span class="footer-meta-separator" aria-hidden="true">•</span>
              <a href="/privacy">Privacy Policy</a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--line);
        background: var(--canvas);
      }
      .site-header .header-row nav a.header-connect-button {
        min-height: 40px;
        padding: 0 18px !important;
        border: 1px solid #fff !important;
        border-radius: 999px !important;
        color: #080808 !important;
        background: #fff !important;
      }
      .site-header .header-row nav a.header-connect-button:hover,
      .site-header .header-row nav a.header-connect-button[aria-current="page"] {
        border-color: #e7e7e7 !important;
        color: #080808 !important;
        background: #e7e7e7 !important;
      }
      .site-header.is-on-light .header-row nav a.header-connect-button {
        border-color: #000 !important;
        color: #fff !important;
        background: #000 !important;
      }
      .site-header.is-on-light .header-row nav a.header-connect-button:hover,
      .site-header.is-on-light .header-row nav a.header-connect-button[aria-current="page"] {
        border-color: #202020 !important;
        color: #fff !important;
        background: #202020 !important;
      }
      .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--space) * 3);
        padding-block: calc(var(--space) * 2.5);
        flex-wrap: wrap;
        row-gap: calc(var(--space) * 1);
      }
      .wordmark {
        font-weight: 700;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
        color: var(--ink);
        text-decoration: none;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
      }
      .wordmark img {
        display: block;
        width: 108px;
        height: 32px;
      }
      .wordmark-dot {
        color: var(--accent-hue);
      }
      .site-header nav {
        display: flex;
        gap: calc(var(--space) * 0.5);
        flex-wrap: wrap;
      }
      .site-header nav a {
        color: var(--ink-secondary);
        text-decoration: none;
        font-size: 0.9375rem;
        font-weight: 520;
        padding: 6px 12px;
        border-radius: 999px;
        transition: color 0.15s ease-out, background 0.15s ease-out;
      }
      .site-header nav a:hover {
        color: var(--ink);
        background: var(--surface);
      }
      .site-header nav a[aria-current="page"] {
        color: var(--ink);
        background: var(--surface-high);
      }
      .site-header-overlay {
        position: fixed;
        inset: 0 0 auto;
        z-index: 50;
        border: 0;
        background: transparent;
        transition: background 220ms ease, color 180ms ease;
      }
      .site-header-overlay.is-scrolled {
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.32) 0%,
          rgba(0, 0, 0, 0.14) 58%,
          rgba(0, 0, 0, 0) 100%
        );
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }
      .site-header-overlay.is-on-light.is-scrolled {
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.44) 0%,
          rgba(255, 255, 255, 0.22) 58%,
          rgba(255, 255, 255, 0) 100%
        );
      }
      .site-header-overlay .wordmark img {
        transition: filter 180ms ease;
      }
      .site-header-overlay.is-on-light .wordmark img {
        filter: invert(1);
      }
      .site-header-overlay .wrap {
        width: min(100%, 1440px);
        max-width: 1440px;
        margin-inline: auto;
        padding-inline: clamp(24px, 3.35vw, 48px);
      }
      .site-header-overlay .header-row nav a {
        display: inline-flex;
        align-items: center;
        color: rgba(255, 255, 255, 0.72);
        background: transparent;
        font-weight: 500;
      }
      .site-header-overlay .header-row nav a:hover,
      .site-header-overlay .header-row nav a[aria-current="page"] {
        color: #fff;
        background: transparent;
      }
      .site-header-overlay.is-on-light .header-row nav a {
        color: rgba(0, 0, 0, 0.68);
      }
      .site-header-overlay.is-on-light .header-row nav a:hover,
      .site-header-overlay.is-on-light .header-row nav a[aria-current="page"] {
        color: #000;
      }
      @media (max-width: 480px) {
        .site-header nav a {
          padding: 5px 8px;
          font-size: 0.875rem;
        }
      }

      .site-footer {
        min-height: 400px;
        border-top: 0;
        overflow: hidden;
        background: #000;
        padding-block: 54px 0;
        margin-top: 0;
      }
      .footer-inner {
        position: relative;
        width: min(100%, 1440px);
        max-width: 1440px;
        padding-inline: clamp(24px, 3.35vw, 48px);
      }
      .footer-links {
        display: grid;
        grid-template-columns: 220px 220px;
        gap: 60px;
      }
      .footer-heading {
        margin-bottom: 16px;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.02em;
        text-transform: none;
      }
      .site-footer ul {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 3px;
        font-size: 0.875rem;
        line-height: 1.3;
      }
      .site-footer ul a {
        color: rgba(255, 255, 255, 0.52);
        text-decoration: none;
      }
      .site-footer ul a:hover {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .footer-note {
        color: rgba(255, 255, 255, 0.34);
      }
      .footer-tagline {
        max-width: none;
        margin-top: 70px;
        color: #fff;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.02em;
      }
      .footer-tagline em {
        color: var(--accent-hue);
        font-family: "Instrument Serif", Georgia, serif;
        font-size: calc(1em + 2px);
        font-weight: 400;
      }
      .footer-lower {
        display: grid;
        grid-template-columns: 400px minmax(0, 1fr);
        gap: 40px;
        align-items: start;
        margin-top: 20px;
      }
      .footer-mega-logo {
        position: relative;
        width: 400px;
        height: 135px;
        overflow: visible;
        clip-path: inset(-100px 0);
        opacity: 0.12;
      }
      .footer-mega-logo img {
        position: absolute;
        top: -10px;
        left: -235px;
        width: 635px;
        height: auto;
        max-width: none;
      }
      .footer-meta {
        padding-top: 41px;
        color: rgba(255, 255, 255, 0.46);
        font-size: 0.875rem;
        line-height: 1.3;
      }
      .footer-meta p {
        max-width: none;
      }
      .footer-meta-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 26px;
      }
      .footer-meta-separator {
        color: inherit;
        line-height: 1;
      }
      .footer-meta a {
        color: rgba(255, 255, 255, 0.46);
        text-decoration: none;
      }
      .footer-meta a:hover { color: #fff; }

      .site-footer-light {
        background: #f7f7f4;
      }
      .site-footer-light .footer-inner::before {
        content: "";
        position: absolute;
        top: -54px;
        right: clamp(24px, 3.35vw, 48px);
        left: clamp(24px, 3.35vw, 48px);
        height: 1px;
        background: #e8e8e3;
      }
      .site-footer-light .footer-heading,
      .site-footer-light .footer-tagline {
        color: #080808;
      }
      .site-footer-light .footer-tagline em {
        color: #8b94f2;
      }
      .site-footer-light ul a {
        color: rgba(8, 8, 8, 0.56);
      }
      .site-footer-light ul a:hover,
      .site-footer-light .footer-meta a:hover {
        color: #080808;
      }
      .site-footer-light .footer-note {
        color: rgba(8, 8, 8, 0.36);
      }
      .site-footer-light .footer-meta,
      .site-footer-light .footer-meta a {
        color: rgba(8, 8, 8, 0.5);
      }
      .site-footer-light .footer-mega-logo img {
        filter: invert(1);
      }
      .site-footer-light .footer-mega-logo {
        opacity: 0.04;
      }

      @media (max-width: 720px) {
        .site-header .header-row nav a.header-connect-button { min-height: 36px; padding-inline: 12px !important; }
        .site-footer { min-height: auto; padding-block: 48px 40px; }
        .footer-inner { width: 100%; padding-inline: 24px; }
        .footer-links { grid-template-columns: 1fr 1fr; gap: 28px; }
        .footer-tagline { margin-top: 58px; font-size: 1.3rem; }
        .footer-lower { grid-template-columns: 1fr; gap: 24px; }
        .footer-mega-logo { width: 100%; height: 108px; overflow: hidden; clip-path: none; }
        .footer-mega-logo img { top: -23px; left: -185px; width: 500px; }
        .footer-meta { padding-top: 0; }
        .site-footer-light .footer-inner::before { top: -48px; }
      }
      @media (max-width: 600px) {
        .site-header .wrap { padding-inline: 22px; }
        .site-header .header-row { flex-wrap: nowrap; gap: 16px; }
        .site-header .header-row nav {
          flex-wrap: nowrap;
          gap: 0;
          margin-left: auto;
        }
        .site-header .header-row nav a:not(.header-connect-button) { display: none; }
        .site-header .header-row nav a.header-connect-button {
          min-height: 32px;
          padding-inline: 16px !important;
          font-size: 0.875rem;
          white-space: nowrap;
        }
      }
      @media (max-width: 480px) {
        .footer-links { grid-template-columns: 1fr; gap: 32px; }
        .footer-tagline { margin-top: 52px; }
        .footer-meta-row { align-items: flex-start; flex-direction: column; gap: 8px; }
        .footer-meta-separator { display: none; }
      }
    </style>

    <script>
      // Progressive enhancement only — the site works fully without JS.

      // Give the fixed landing header a subtle glass surface after scrolling,
      // and switch its contrast when a light section moves behind it.
      const siteHeader = document.querySelector<HTMLElement>(".site-header");
      const syncHeaderSurface = () => {
        if (!siteHeader) return;
        siteHeader.classList.toggle("is-scrolled", scrollY > 12);

        const probeY = Math.max(1, Math.min(innerHeight - 1, siteHeader.offsetHeight / 2));
        const backdrop = [...document.querySelectorAll<HTMLElement>("[data-header-tone]")].find(
          (section) => {
            const bounds = section.getBoundingClientRect();
            return bounds.top <= probeY && bounds.bottom > probeY;
          },
        );
        siteHeader.classList.toggle("is-on-light", backdrop?.dataset.headerTone === "light");
      };
      let headerFrame = 0;
      const scheduleHeaderSurface = () => {
        if (headerFrame) return;
        headerFrame = requestAnimationFrame(() => {
          headerFrame = 0;
          syncHeaderSurface();
        });
      };
      syncHeaderSurface();
      addEventListener("scroll", scheduleHeaderSurface, { passive: true });
      addEventListener("resize", scheduleHeaderSurface, { passive: true });

      // 1) Copy buttons on code blocks.
      for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
        btn.addEventListener("click", async () => {
          const code = btn.closest(".codeblock")?.querySelector("code");
          if (!code) return;
          try {
            await navigator.clipboard.writeText(code.textContent ?? "");
            btn.textContent = "Copied";
          } catch {
            // Clipboard unavailable — select the text so ⌘C still works.
            getSelection()?.selectAllChildren(code);
            btn.textContent = "Press ⌘C";
          }
          setTimeout(() => (btn.textContent = "Copy"), 1500);
        });
      }

      // 2) Scroll reveals — .reveal elements rise in on first view.
      //    Hidden state is applied by JS, so no-JS never hides content.
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches ||
        new URLSearchParams(location.search).has("qa");
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (!reduced && revealEls.length && "IntersectionObserver" in window) {
        let stagger = 0;
        const ioReveal = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              ioReveal.unobserve(e.target);
              const el = e.target as HTMLElement;
              el.style.transitionDelay = `${Math.min(stagger++ % 3, 2) * 90}ms`;
              el.classList.add("reveal-in");
            }
          },
          { threshold: 0.12 }
        );
        for (const el of revealEls) {
          el.classList.add("reveal-pre");
          ioReveal.observe(el);
        }
      }

      // 3) Per-letter "shiver" reveal on section headlines (.shiver),
      //    once, on scroll-into-view. Static under reduced motion.
      const headlines = document.querySelectorAll<HTMLElement>(".shiver");
      if (!reduced && headlines.length && "IntersectionObserver" in window) {
        for (const h of headlines) {
          const frag = document.createDocumentFragment();
          for (const node of [...h.childNodes]) {
            if (node.nodeType === Node.TEXT_NODE) {
              for (const ch of node.textContent ?? "") {
                if (ch === " ") {
                  frag.append(" ");
                } else {
                  const s = document.createElement("span");
                  s.className = "shiver-ch";
                  s.textContent = ch;
                  frag.append(s);
                }
              }
            } else {
              frag.append(node); // keep .accent spans intact
            }
          }
          h.replaceChildren(frag);
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              const chars = e.target.querySelectorAll(".shiver-ch");
              chars.forEach((c, i) => {
                (c as HTMLElement).style.animationDelay = `${i * 18}ms`;
                c.classList.add("shiver-run");
              });
            }
          },
          { threshold: 0.4 }
        );
        for (const h of headlines) io.observe(h);
      }
    </script>

    <style is:global>
      .shiver-ch {
        display: inline-block;
      }
      .shiver-run {
        animation: shiver 0.45s ease-out both;
      }
      @keyframes shiver {
        0% {
          opacity: 0;
          transform: translateY(0.18em) rotate(3deg);
        }
        60% {
          opacity: 1;
          transform: translateY(-0.04em) rotate(-1.5deg);
        }
        100% {
          opacity: 1;
          transform: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .shiver-run {
          animation: none;
        }
      }
    </style>
  </body>
</html>
