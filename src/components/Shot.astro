---
/** Screenshot figure with caption. Missing assets stay out of the rendered guide. */
import fs from "node:fs";
import path from "node:path";

interface Props {
  src: string; // e.g. "/shots/claude-web-connectors.png"
  alt: string;
  caption: string;
}
const { src, alt, caption } = Astro.props;
const exists = fs.existsSync(path.join("public", src));
---

{
  exists && (
    <figure class="shot">
      <img src={src} alt={alt} loading="lazy" decoding="async" />
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<style>
  .shot {
    margin: calc(var(--space) * 3) 0;
  }
  .shot img {
    max-width: 100%;
    border-radius: var(--radius-shot);
    border: 1px solid var(--outline);
    display: block;
  }
  figcaption {
    font-size: 0.875rem;
    color: var(--ink-muted);
    margin-top: calc(var(--space) * 1);
  }
</style>
