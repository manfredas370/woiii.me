---
/**
 * Product-family card — the owner's established visual grammar:
 * colored border, name chip, one-sentence description, one accent
 * tint per card (same pattern as the extension's what's-new rail).
 */
interface Props {
  token: string;
  tint: "blue" | "green" | "gold";
  description: string;
  href?: string;
  badge?: string;
}
const { token, tint, description, href, badge } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class={`product-card ${tint}`} href={href}>
  <span class="chip">{token}</span>
  {badge && <span class="badge">{badge}</span>}
  <p class="desc">{description}</p>
  {href && <span class="cta" aria-hidden="true">Connect →</span>}
</Tag>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space) * 2);
    border-radius: var(--radius-card);
    padding: calc(var(--space) * 3);
    background: var(--canvas);
    border: 2px solid;
    text-decoration: none;
    color: var(--ink);
    min-height: 190px;
  }
  .product-card.blue {
    border-color: var(--blue-ink);
  }
  .product-card.green {
    border-color: var(--green-ink);
  }
  .product-card.gold {
    border-color: var(--gold-ink);
  }

  .chip {
    font-weight: 650;
    font-size: 0.95rem;
    border-radius: 999px;
    padding: 4px 14px;
  }
  .blue .chip {
    background: var(--blue-tint);
    color: var(--blue-ink);
  }
  .green .chip {
    background: var(--green-tint);
    color: var(--green-ink);
  }
  .gold .chip {
    background: var(--gold-tint);
    color: var(--gold-ink);
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    border: 1px solid var(--outline-strong);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .desc {
    font-size: 0.98rem;
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--blue-ink);
  }
  a.product-card:hover {
    background: var(--surface);
  }
</style>
