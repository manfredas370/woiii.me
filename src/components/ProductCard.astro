---
/**
 * Product-family card — v2 "warm editorial". Elevated warm surface,
 * soft shadow, a colored accent rule and chip per product, catalog
 * number as a quiet stamp. One accent tint per card.
 */
interface Props {
  token: string;
  catalog: string;
  tint: "green" | "gold" | "clay" | "blue";
  description: string;
  href?: string;
  badge?: string;
}
const { token, catalog, tint, description, href, badge } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class={`product-card ${tint}`} href={href}>
  <span class="accent-rule" aria-hidden="true"></span>
  <div class="card-top">
    <span class="chip">{token}</span>
    <span class="catalog">{catalog}</span>
  </div>
  {badge && <span class="badge">{badge}</span>}
  <p class="desc">{description}</p>
  {href && <span class="cta" aria-hidden="true">Connect →</span>}
</Tag>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space) * 2);
    border-radius: var(--radius-card);
    padding: calc(var(--space) * 3.5) calc(var(--space) * 3);
    background: var(--surface-high);
    border: 1px solid var(--line-soft);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: var(--ink);
    min-height: 210px;
    overflow: hidden;
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
  }

  /* colored accent rule along the top edge */
  .accent-rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
  }
  .green .accent-rule {
    background: var(--green-ink);
  }
  .gold .accent-rule {
    background: var(--gold-ink);
  }
  .clay .accent-rule {
    background: var(--clay-ink);
  }
  .blue .accent-rule {
    background: var(--blue-ink);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .chip {
    font-weight: 650;
    font-size: 0.9375rem;
    border-radius: 999px;
    padding: 4px 14px;
  }
  .green .chip {
    background: var(--green-tint);
    color: var(--green-ink);
  }
  .gold .chip {
    background: var(--gold-tint);
    color: var(--gold-ink);
  }
  .clay .chip {
    background: var(--clay-tint);
    color: var(--clay-ink);
  }
  .blue .chip {
    background: var(--blue-tint);
    color: var(--blue-deep);
  }

  .catalog {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-tertiary);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .desc {
    font-size: 0.9375rem;
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--grass-deep);
  }
  a.product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-float);
  }
  a.product-card:hover .cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    a.product-card:hover {
      transform: none;
    }
  }
</style>
