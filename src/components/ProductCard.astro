---
/**
 * Product-family card — the owner's established visual grammar:
 * colored border, name chip, one-sentence description, one accent
 * tint per card (same pattern as the extension's what's-new rail).
 * The catalog number is the deadwax etching — WOIII·001, 002, 003.
 */
interface Props {
  token: string;
  catalog: string;
  tint: "blue" | "green" | "gold";
  description: string;
  href?: string;
  badge?: string;
}
const { token, catalog, tint, description, href, badge } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class={`product-card ${tint}`} href={href}>
  <div class="card-top">
    <span class="chip">{token}</span>
    <span class="catalog">{catalog}</span>
  </div>
  {badge && <span class="badge">{badge}</span>}
  <p class="desc">{description}</p>
  {href && <span class="cta" aria-hidden="true">Connect →</span>}
</Tag>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space) * 2);
    border-radius: var(--radius-card);
    padding: calc(var(--space) * 3);
    border: 1px solid;
    text-decoration: none;
    color: var(--ink);
    min-height: 200px;
    transition: border-color 0.15s ease-out, background 0.15s ease-out;
  }
  /* hairline in the card's hue + a whisper of its tint as wash */
  .product-card.blue {
    border-color: color-mix(in srgb, var(--blue-ink) 35%, transparent);
    background: color-mix(in srgb, var(--blue-tint) 30%, var(--canvas));
  }
  .product-card.green {
    border-color: color-mix(in srgb, var(--green-ink) 30%, transparent);
    background: color-mix(in srgb, var(--green-tint) 30%, var(--canvas));
  }
  .product-card.gold {
    border-color: color-mix(in srgb, var(--gold-ink) 30%, transparent);
    background: color-mix(in srgb, var(--gold-tint) 30%, var(--canvas));
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .chip {
    font-weight: 650;
    font-size: 0.9375rem;
    border-radius: 999px;
    padding: 4px 14px;
  }
  .blue .chip {
    background: var(--blue-tint);
    color: var(--blue-deep);
  }
  .green .chip {
    background: var(--green-tint);
    color: var(--green-ink);
  }
  .gold .chip {
    background: var(--gold-tint);
    color: var(--gold-ink);
  }

  /* deadwax etching */
  .catalog {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-tertiary);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .desc {
    font-size: 0.9375rem;
    color: var(--ink-secondary);
    line-height: 1.55;
  }

  .cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent-hue);
  }
  a.product-card:hover {
    border-color: var(--accent-hue);
    background: color-mix(in srgb, var(--blue-tint) 55%, var(--canvas));
  }
  a.product-card:hover .cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
