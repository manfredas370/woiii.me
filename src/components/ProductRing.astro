---
/**
 * Wrapped album-cover ring — cylindrical hero geometry:
 * N square covers on a cylinder of radius R viewed from inside
 * (translate3d(R·sinθ, 0, −R·cosθ) rotateY(−θ), 800px perspective),
 * plus slow continuous rotation. Server-renders the initial positions
 * so the wrap is intact without JS; the script only animates.
 */

interface AlbumCover {
  src: string;
  alt: string;
}

const unique: AlbumCover[] = [
  { src: "/images/albums/01.png", alt: "Antonio Carlos Jobim — Wave album cover" },
  { src: "/images/albums/02.png", alt: "Steely Dan — Can't Buy a Thrill album cover" },
  { src: "/images/albums/03.png", alt: "Pescado Rabioso — Artaud album cover" },
  { src: "/images/albums/04.png", alt: "Jungle album cover" },
  { src: "/images/albums/05.png", alt: "Selected album cover with two figures against abstract artwork" },
  { src: "/images/albums/06.png", alt: "Saracho — En Medio album cover" },
  { src: "/images/albums/07.png", alt: "The Famous Sound of Three Blind Mice, volume one album cover" },
];
const covers: AlbumCover[] = [...unique, ...unique];

const N = covers.length;
const STEP = 360 / N;
const R = 1240;

/** Same math the client script uses — initial frame for no-JS/reduced-motion. */
function pose(i: number) {
  let th = ((i * STEP + 180) % 360) - 180;
  const rad = (th * Math.PI) / 180;
  const x = R * Math.sin(rad);
  const z = -R * Math.cos(rad);
  const a = Math.abs(th);
  const opacity = a < 80 ? 1 : a > 105 ? 0 : 1 - (a - 80) / 25;
  return {
    transform: `translate(-50%, -50%) translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${-th}deg)`,
    opacity: String(Math.round(opacity * 100) / 100),
  };
}
---

<div class="ring-stage" data-radius={R}>
  <div class="ring">
    {
      covers.map((cover, i) => {
        const p = pose(i);
        return (
          <div
            class="ring-card"
            style={`transform: ${p.transform}; opacity: ${p.opacity}`}
            aria-hidden={i >= unique.length ? "true" : undefined}
          >
            <img
              src={cover.src}
              alt={i < unique.length ? cover.alt : ""}
              width="600"
              height="600"
              loading="eager"
              decoding="async"
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .ring-stage {
    position: relative;
    width: 100vw;
    height: 700px;
    margin-left: calc(50% - 50vw);
    perspective: clamp(1760px, 144vw, 2200px);
    overflow: clip;
    /* Keep the cylinder full-bleed while gently dissolving only its clipped edges. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 1.5%,
      #000 98.5%,
      transparent
    );
    mask-image: linear-gradient(to right, transparent, #000 1.5%, #000 98.5%, transparent);
  }
  .ring {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .ring-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(480px, 39.3vw, 540px);
    aspect-ratio: 1;
    border-radius: clamp(10px, 1.4vw, 20px);
    border: 0;
    overflow: hidden;
    isolation: isolate;
    will-change: transform, opacity;
    backface-visibility: hidden;
    background: #111;
    box-shadow: 0 30px 72px rgba(0, 0, 0, 0.36);
  }
  .ring-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .ring-stage {
      width: 100vw;
      height: 400px;
      perspective: 1020px;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 1%, #000 99%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 1%, #000 99%, transparent);
    }
    .ring-card {
      width: 276px;
      border-radius: 10px;
    }
  }

</style>

<script>
  const stage = document.querySelector<HTMLElement>(".ring-stage");
  const ring = stage?.querySelector<HTMLElement>(".ring");
  if (stage && ring) {
    const cards = [...ring.children] as HTMLElement[];
    const N = cards.length;
    const STEP = 360 / N;
    const baseRadius = Number(stage.dataset.radius);
    const qa = new URLSearchParams(location.search).has("qa");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches || qa;
    if (qa) stage.dataset.qa = "true";

    let angle = 0;
    let last = 0;
    let running = false;
    let raf = 0;

    const radius = () => {
      const cardWidth = cards[0]?.offsetWidth || (innerWidth < 600 ? 276 : 540);
      const gap = 12;
      return (cardWidth + gap) / (2 * Math.sin(Math.PI / N)) || baseRadius;
    };

    const render = () => {
      for (let i = 0; i < N; i++) {
        let th = ((angle + i * STEP + 180) % 360) - 180;
        if (th < -180) th += 360;
        const rad = (th * Math.PI) / 180;
        const a = Math.abs(th);
        const el = cards[i];
        const R = radius();
        el.style.transform = `translate(-50%, -50%) translate3d(${R * Math.sin(rad)}px, 0, ${-R * Math.cos(rad)}px) rotateY(${-th}deg)`;
        el.style.opacity = a < 80 ? "1" : a > 105 ? "0" : String(1 - (a - 80) / 25);
        el.style.visibility = a > 110 ? "hidden" : "visible";
      }
    };

    const tick = (ts: number) => {
      if (last) angle = (angle + (ts - last) * 0.008) % 360; // 8°/s ≈ 45 s per lap
      last = ts;
      render();
      if (running) raf = requestAnimationFrame(tick);
    };
    const start = () => {
      if (running || reduced) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    render();
    if (!reduced && "IntersectionObserver" in window) {
      new IntersectionObserver(
        (es) => es.forEach((e) => (e.isIntersecting ? start() : stop())),
        { threshold: 0.15 }
      ).observe(stage);
      stage.addEventListener("pointerenter", stop);
      stage.addEventListener("pointerleave", start);
      addEventListener("resize", render, { passive: true });
    }
  }
</script>
