---
/**
 * Wrapped product-card ring — the Bending Spoons hero geometry:
 * N cards on a cylinder of radius R viewed from inside
 * (translate3d(R·sinθ, 0, −R·cosθ) rotateY(−θ), 800px perspective),
 * plus slow continuous rotation. Server-renders the initial positions
 * so the wrap is intact without JS; the script only animates.
 * Desktop only — the family grid takes over below 900px.
 */
import { DIG, MIX, RIG } from "../config/brand";

interface RingCard {
  token: string;
  catalog: string;
  tint: "blue" | "green" | "gold" | "paper";
  line: string;
  badge?: string;
  href?: string;
}

const unique: RingCard[] = [
  { token: DIG.token, catalog: "WOIII·001", tint: "blue", line: "Pressing intelligence in your AI assistant.", href: "/connect" },
  { token: MIX.token, catalog: "WOIII·002", tint: "green", line: "A bespoke playlist concierge.", badge: MIX.badge },
  { token: DIG.token, catalog: "WOIII·001", tint: "blue", line: "The side panel for discogs.com.", href: "/connect#extension" },
  { token: RIG.token, catalog: "WOIII·003", tint: "gold", line: "An AI hi-fi gear finder.", badge: RIG.badge },
  { token: "WOIII.me", catalog: "EST·2026", tint: "paper", line: "Free tools, open source, no tracking." },
];
const cards: RingCard[] = [...unique, ...unique];

const N = cards.length;
const STEP = 360 / N;
const R = 480;

/** Same math the client script uses — initial frame for no-JS/reduced-motion. */
function pose(i: number) {
  let th = ((i * STEP + 180) % 360) - 180;
  const rad = (th * Math.PI) / 180;
  const x = R * Math.sin(rad);
  const z = -R * Math.cos(rad);
  const a = Math.abs(th);
  const opacity = a < 80 ? 1 : a > 105 ? 0 : 1 - (a - 80) / 25;
  return {
    transform: `translate(-50%, -50%) translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${-th}deg)`,
    opacity: String(Math.round(opacity * 100) / 100),
  };
}
---

<div class="ring-stage" data-radius={R}>
  <div class="ring">
    {
      cards.map((c, i) => {
        const p = pose(i);
        const Tag = c.href ? "a" : "div";
        return (
          <Tag
            class={`ring-card ${c.tint}`}
            href={c.href}
            style={`transform: ${p.transform}; opacity: ${p.opacity}`}
            aria-hidden={i >= unique.length ? "true" : undefined}
            tabindex={c.href && i >= unique.length ? -1 : undefined}
          >
            <span class="ring-chip">{c.token}</span>
            {c.badge && <span class="ring-badge">{c.badge}</span>}
            <p class="ring-line">{c.line}</p>
            <span class="ring-catalog">{c.catalog}</span>
            <span class="ring-groove" aria-hidden="true" />
          </Tag>
        );
      })
    }
  </div>
</div>

<style>
  .ring-stage {
    position: relative;
    height: 400px;
    perspective: 800px;
    overflow: clip;
    /* edges dissolve into the canvas, like theirs into black */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .ring {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .ring-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 250px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    border: 1px solid;
    padding: calc(var(--space) * 2.5);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--space) * 1.5);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }
  .ring-card.blue {
    background: var(--blue-tint);
    border-color: color-mix(in srgb, var(--blue-ink) 30%, transparent);
  }
  .ring-card.green {
    background: var(--green-tint);
    border-color: color-mix(in srgb, var(--green-ink) 25%, transparent);
  }
  .ring-card.gold {
    background: var(--gold-tint);
    border-color: color-mix(in srgb, var(--gold-ink) 25%, transparent);
  }
  .ring-card.paper {
    background: var(--surface);
    border-color: var(--line-strong);
  }

  .ring-chip {
    font-weight: 680;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .blue .ring-chip {
    color: var(--blue-deep);
  }
  .green .ring-chip {
    color: var(--green-ink);
  }
  .gold .ring-chip {
    color: var(--gold-ink);
  }
  .paper .ring-chip {
    color: var(--ink);
  }

  .ring-badge {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-tertiary);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 2px 9px;
  }

  .ring-line {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-secondary);
    max-width: 100%;
  }

  .ring-catalog {
    margin-top: auto;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  /* label-center grooves, cropped at the card's corner */
  .ring-groove {
    position: absolute;
    right: -70px;
    bottom: -70px;
    width: 190px;
    height: 190px;
    border-radius: 999px;
    background: repeating-radial-gradient(
        circle at center,
        transparent 0 9px,
        rgba(255, 255, 255, 0.06) 9px 10px
      );
    pointer-events: none;
  }

  a.ring-card:hover .ring-line {
    color: var(--ink);
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>(".ring-stage");
  const ring = stage?.querySelector<HTMLElement>(".ring");
  if (stage && ring) {
    const cards = [...ring.children] as HTMLElement[];
    const N = cards.length;
    const STEP = 360 / N;
    const R = Number(stage.dataset.radius);
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let angle = 0;
    let last = 0;
    let running = false;
    let raf = 0;

    const render = () => {
      for (let i = 0; i < N; i++) {
        let th = ((angle + i * STEP + 180) % 360) - 180;
        if (th < -180) th += 360;
        const rad = (th * Math.PI) / 180;
        const a = Math.abs(th);
        const el = cards[i];
        el.style.transform = `translate(-50%, -50%) translate3d(${R * Math.sin(rad)}px, 0, ${-R * Math.cos(rad)}px) rotateY(${-th}deg)`;
        el.style.opacity = a < 80 ? "1" : a > 105 ? "0" : String(1 - (a - 80) / 25);
        el.style.visibility = a > 110 ? "hidden" : "visible";
      }
    };

    const tick = (ts: number) => {
      if (last) angle = (angle + (ts - last) * 0.008) % 360; // 8°/s ≈ 45 s per lap
      last = ts;
      render();
      if (running) raf = requestAnimationFrame(tick);
    };
    const start = () => {
      if (running || reduced) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    render();
    if (!reduced && "IntersectionObserver" in window) {
      new IntersectionObserver(
        (es) => es.forEach((e) => (e.isIntersecting ? start() : stop())),
        { threshold: 0.15 }
      ).observe(stage);
      stage.addEventListener("pointerenter", stop);
      stage.addEventListener("pointerleave", start);
    }
  }
</script>
