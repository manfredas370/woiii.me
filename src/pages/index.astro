<script>
  const scrollReveal = document.querySelector<HTMLElement>("[data-scroll-text-reveal]");

  if (scrollReveal) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches ||
      new URLSearchParams(location.search).has("qa");

    if (!reduced) {
      const words: HTMLElement[] = [];
      const paragraphs = scrollReveal.querySelectorAll<HTMLElement>("p");

      for (const paragraph of paragraphs) {
        const accessibleCopy = paragraph.textContent?.trim();
        if (accessibleCopy && !paragraph.hasAttribute("aria-label")) {
          paragraph.setAttribute("aria-label", accessibleCopy);
        }

        const walker = document.createTreeWalker(paragraph, NodeFilter.SHOW_TEXT);
        const textNodes: Text[] = [];
        let current: Node | null;
        while ((current = walker.nextNode())) textNodes.push(current as Text);

        for (const textNode of textNodes) {
          const fragment = document.createDocumentFragment();
          for (const part of textNode.data.split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              fragment.append(part);
              continue;
            }

            const word = document.createElement("span");
            word.className = "scroll-reveal-word";
            word.setAttribute("aria-hidden", "true");
            word.textContent = part;
            fragment.append(word);
          }
          textNode.replaceWith(fragment);
        }

        words.push(...paragraph.querySelectorAll<HTMLElement>(".scroll-reveal-word"));
      }

      let frame = 0;
      const clamp = (value: number) => Math.min(1, Math.max(0, value));

      const render = () => {
        frame = 0;
        const rect = scrollReveal.getBoundingClientRect();
        const documentTop = rect.top + scrollY;
        const start = documentTop - innerHeight * 0.85;
        const end = documentTop + rect.height - innerHeight * 0.35;
        const progress = clamp((scrollY - start) / Math.max(end - start, 1));
        const count = words.length;

        for (let index = 0; index < count; index++) {
          const reveal = clamp(progress * count - index);
          words[index].style.opacity = String(0.15 + reveal * 0.85);
          words[index].style.filter = `blur(${(1 - reveal) * 6}px)`;
        }
      };

      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(render);
      };

      addEventListener("scroll", schedule, { passive: true });
      addEventListener("resize", schedule, { passive: true });
      render();
    }
  }
</script>

<script>
  const motionReduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!motionReduced) {
    const pointerFine = matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (pointerFine) {
      const artCards = [...document.querySelectorAll<HTMLElement>(".product-art-card")];
      const resetPointerCard = (card: HTMLElement) => {
        card.classList.remove("is-pointer-active");
        card.style.setProperty("--gradient-x", "0px");
        card.style.setProperty("--gradient-y", "0px");
        card.style.setProperty("--pointer-x", "50%");
        card.style.setProperty("--pointer-y", "50%");
      };

      for (const card of artCards) {
        let pointerFrame = 0;
        let pointerClientX = 0;
        let pointerClientY = 0;

        const renderPointer = () => {
          pointerFrame = 0;
          const rect = card.getBoundingClientRect();
          const x = Math.max(0, Math.min(1, (pointerClientX - rect.left) / rect.width));
          const y = Math.max(0, Math.min(1, (pointerClientY - rect.top) / rect.height));
          const shiftX = (x - 0.5) * 36;
          const shiftY = (y - 0.5) * 36;

          card.style.setProperty("--gradient-x", `${shiftX.toFixed(2)}px`);
          card.style.setProperty("--gradient-y", `${shiftY.toFixed(2)}px`);
          card.style.setProperty("--pointer-x", `${(x * 100).toFixed(2)}%`);
          card.style.setProperty("--pointer-y", `${(y * 100).toFixed(2)}%`);
        };

        card.addEventListener("pointermove", (event) => {
          if (!card.classList.contains("is-pointer-active")) {
            for (const otherCard of artCards) {
              if (otherCard !== card) resetPointerCard(otherCard);
            }
          }
          card.classList.add("is-pointer-active");
          pointerClientX = event.clientX;
          pointerClientY = event.clientY;
          if (!pointerFrame) pointerFrame = requestAnimationFrame(renderPointer);
        }, { passive: true });

        card.addEventListener("pointerleave", () => {
          if (pointerFrame) cancelAnimationFrame(pointerFrame);
          pointerFrame = 0;
          resetPointerCard(card);
        }, { passive: true });
      }
    }

    const panels = document.querySelectorAll<HTMLElement>("[data-parallax]");
    let ticking = false;
    const updatePanels = () => {
      for (const panel of panels) {
        const rect = panel.getBoundingClientRect();
        const center = rect.top + rect.height / 2 - innerHeight / 2;
        const shift = Math.max(-18, Math.min(18, center * -0.025));
        panel.style.setProperty("--shift", `${shift}px`);
      }
      ticking = false;
    };
    addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updatePanels);
    }, { passive: true });
    updatePanels();
  }
</script>
