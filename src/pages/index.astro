---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { DIG, MIX, RIG } from "../config/brand";
---

<Base
  title="WOIII.me — AI-powered tools for music lovers"
  description="Home of DIG for Discogs: pressing intelligence for your AI assistant and your browser. Which copy of this album should I buy? Answered with evidence, not folklore."
>
  <!-- ============================================================ -->
  <!-- 1 · Hero — category H1, short bold subhead, one CTA,          -->
  <!--     availability line, big product demo                      -->
  <!-- ============================================================ -->
  <section class="hero">
    <div class="wrap">
      <h1>The pressing guide for serious record buyers</h1>
      <p class="hero-sub">
        Evidence, not folklore.<br />Without leaving your AI assistant.
      </p>
      <div class="hero-ctas">
        <a class="btn filled" href="/connect">Connect DIG for free</a>
      </div>
      <p class="hero-avail">Works with Claude, ChatGPT, Codex, and Chrome</p>
    </div>

    <div class="wrap hero-demo-wrap">
      <div class="hero-demo">
        <div class="window big" role="img" aria-label="Example conversation: user asks which pressing of OK Computer to buy; the assistant calls the find_best_pressing tool and ranks three pressings with scores and evidence">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">Claude</span>
          </div>
          <div class="window-body chat">
            <p class="chat-q">What's the best-sounding pressing of OK Computer?</p>
            <p class="tool-chip"><span class="tool-glyph">⚙</span> find_best_pressing · axis: sonic</p>
            <div class="chat-a">
              <p class="rank"><span class="rank-n">1</span><span><strong>2016 XL 2×LP reissue</strong> — 92/100<br /><span class="rank-why">cut from the original masters · 4.6★ from 3k+ owners</span></span></p>
              <p class="rank"><span class="rank-n">2</span><span><strong>1997 UK first pressing</strong> — 88/100<br /><span class="rank-why">collector favourite, prices climbing</span></span></p>
              <p class="rank"><span class="rank-n">3</span><span><strong>2017 US repress</strong> — 79/100<br /><span class="rank-why">solid value pick</span></span></p>
              <p class="chat-meta">Evidence: 41 versions surveyed · community ratings + audiophile markers</p>
            </div>
          </div>
        </div>
        <!-- floating side chips, Granola-style -->
        <div class="float-chip fc-1" aria-hidden="true"><span class="fc-dot"></span>Surveying 41 versions…</div>
        <div class="float-chip fc-2" aria-hidden="true">✓ Evidence coverage shown</div>
      </div>

      <!-- claims strip under the demo -->
      <ul class="claims">
        <li><strong>Read-only,</strong> on your own Discogs account</li>
        <li><strong>Private by default</strong> — no ads, no data collection</li>
        <li><strong>Free &amp; open source,</strong> no invite needed</li>
      </ul>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 2 · Wordmark wall — "For the doers / Trusted by…" analog      -->
  <!-- ============================================================ -->
  <section class="wall">
    <div class="wrap">
      <p class="wall-kicker">For the diggers</p>
      <p class="wall-title">Works with the tools you already use</p>
      <ul class="wordmarks">
        <li>Claude</li>
        <li>ChatGPT</li>
        <li>Codex</li>
        <li>Chrome</li>
        <li>Discogs</li>
      </ul>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 3 · Tabbed journey — before / during / after the hunt        -->
  <!-- ============================================================ -->
  <section class="section journey">
    <div class="wrap">
      <h2 class="journey-head">DIG helps you before, during and after the&nbsp;hunt.</h2>

      <div class="tabs">
        <input class="tab-radio" type="radio" name="phase" id="tab-before" checked />
        <input class="tab-radio" type="radio" name="phase" id="tab-during" />
        <input class="tab-radio" type="radio" name="phase" id="tab-after" />

        <div class="tab-bar" role="tablist" aria-label="When DIG helps">
          <label for="tab-before">Before you buy</label>
          <label for="tab-during">While you browse</label>
          <label for="tab-after">After you add</label>
        </div>

        <div class="tab-panels">
          <!-- BEFORE -->
          <div class="tab-panel panel-before">
            <div class="panel-copy">
              <h3>Know which copy is worth it</h3>
              <p>
                Ask about any album and DIG surveys every version on Discogs,
                scoring each on community ratings, collector demand, and
                audiophile markers — original vs. reissue, MFSL and half-speed
                masters, renowned mastering engineers, Japanese pressings.
              </p>
              <p class="honest-note">
                Honest caveat: the first analysis of an album takes about
                10 seconds. Good answers are worth the wait.
              </p>
            </div>
            <div class="panel-shot">
              <div class="window" role="img" aria-label="Assistant ranking three pressings of an album with scores">
                <div class="window-bar">
                  <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="window-title">Claude</span>
                </div>
                <div class="window-body chat">
                  <p class="tool-chip"><span class="tool-glyph">⚙</span> compare_pressings · axis: value</p>
                  <div class="chat-a">
                    <p class="rank"><span class="rank-n">1</span><span><strong>2017 US repress</strong> — best value at ~€25<br /><span class="rank-why">96% of the sonics for a third of the price</span></span></p>
                    <p class="rank"><span class="rank-n">2</span><span><strong>2016 XL reissue</strong> — the safe pick<br /><span class="rank-why">widely available, consistently well-rated</span></span></p>
                    <p class="chat-meta">Evidence: prices + 3k community ratings</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- DURING -->
          <div class="tab-panel panel-during">
            <div class="panel-copy">
              <h3>Scores beside every listing</h3>
              <p>
                The DIG side panel for Chrome shows pressing intelligence right
                next to the listing you're looking at — scores, red flags, and
                better alternatives while you browse or shop on discogs.com.
              </p>
              <p><a href="/connect#extension">Install the extension →</a></p>
            </div>
            <div class="panel-shot">
              <div class="window" role="img" aria-label="Side panel showing a pressing score of 84 with three signals">
                <div class="window-bar">
                  <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="window-title">DIG · discogs.com</span>
                </div>
                <div class="window-body panel">
                  <p class="panel-title">This pressing <span class="panel-score">84</span></p>
                  <ul class="panel-signals">
                    <li><span class="sig ok">✓</span> Original mastering, well-rated (4.4★)</li>
                    <li><span class="sig ok">✓</span> Sought by 1.2k collectors</li>
                    <li><span class="sig warn">△</span> 2019 repress rates higher for playback</li>
                  </ul>
                  <p class="chat-meta">Based on 27 versions of this master</p>
                </div>
              </div>
            </div>
          </div>

          <!-- AFTER -->
          <div class="tab-panel panel-after">
            <div class="panel-copy">
              <h3>Your shelf, ranked and ready</h3>
              <p>
                DIG knows your collection and wantlist. Rank your wantlist by
                what's actually worth chasing, profile your taste, or get
                rating-weighted picks from records you already own.
              </p>
              <p class="honest-note">
                Slash commands in supported clients:
                <code>/rank-my-wantlist</code>, <code>/my-taste-profile</code>,
                <code>/pick-from-my-collection</code>.
              </p>
            </div>
            <div class="panel-shot">
              <div class="window" role="img" aria-label="Assistant ranking the user's wantlist by priority">
                <div class="window-bar">
                  <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="window-title">Claude</span>
                </div>
                <div class="window-body chat">
                  <p class="tool-chip"><span class="tool-glyph">⚙</span> /rank-my-wantlist</p>
                  <div class="chat-a">
                    <p class="rank"><span class="rank-n">1</span><span><strong>In a Silent Way — 1969 US</strong><br /><span class="rank-why">prices climbing · rare in this grade</span></span></p>
                    <p class="rank"><span class="rank-n">2</span><span><strong>Kind of Blue — MFSL 2×45</strong><br /><span class="rank-why">strong sonics score, stable price</span></span></p>
                    <p class="chat-meta">Ranked 14 wantlist items by urgency</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 4 · Big feature — "Perfect meeting memory" analog             -->
  <!-- ============================================================ -->
  <section class="section memory">
    <div class="wrap memory-grid">
      <div>
        <p class="eyebrow">DIG knows your shelf</p>
        <h2 class="memory-head">Perfect<br />collection<br />memory</h2>
      </div>
      <div class="memory-demo">
        <p class="memory-q">What should I spin tonight?</p>
        <div class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">Claude</span>
          </div>
          <div class="window-body chat">
            <p class="tool-chip"><span class="tool-glyph">⚙</span> spin · mood: late night</p>
            <div class="chat-a">
              <p class="rank"><span class="rank-n">♪</span><span><strong>Talk Talk — Spirit of Eden</strong><br /><span class="rank-why">your 5★ shelf, unplayed for a while</span></span></p>
              <p class="rank"><span class="rank-n">♪</span><span><strong>Alice Coltrane — Journey in Satchidananda</strong><br /><span class="rank-why">fits the mood, rated 4.5★ by you</span></span></p>
              <p class="chat-meta">Picked from your own collection · rating-weighted</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 5 · Honest numbers — our truth-wall (no invented quotes)      -->
  <!-- ============================================================ -->
  <section class="section truths">
    <div class="wrap">
      <h2 class="truths-head">Built on evidence, honest about&nbsp;it</h2>
      <div class="truth-cards">
        <div class="truth-card num">
          <p class="truth-big">15</p>
          <p class="truth-label">MCP tools</p>
        </div>
        <div class="truth-card num">
          <p class="truth-big">10</p>
          <p class="truth-label">Slash-command prompts</p>
        </div>
        <div class="truth-card quote">
          <p>Scores are based on reputation and community data, not measured sound.</p>
        </div>
        <div class="truth-card num">
          <p class="truth-big">9</p>
          <p class="truth-label">REST endpoints</p>
        </div>
        <div class="truth-card quote">
          <p>Every verdict shows how much evidence sits behind it.</p>
        </div>
        <div class="truth-card num">
          <p class="truth-big">0</p>
          <p class="truth-label">Trackers &amp; ads</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 6 · Features grid — "Works everywhere you do" analog          -->
  <!-- ============================================================ -->
  <section class="section featgrid">
    <div class="wrap">
      <div class="featgrid-head">
        <h2>Works wherever you&nbsp;dig</h2>
        <a class="btn filled" href="/connect">Connect DIG for free</a>
      </div>
      <div class="feat-cards">
        <div class="feat-card">
          <h3>Evidence on display</h3>
          <p>Every verdict shows its evidence coverage — how many versions were surveyed and what the score rests on.</p>
        </div>
        <div class="feat-card">
          <h3>Audiophile markers</h3>
          <p>MFSL and half-speed masters, renowned mastering engineers, Japanese pressings — weighed, not worshipped.</p>
        </div>
        <div class="feat-card">
          <h3>Read-only, your account</h3>
          <p>DIG runs on your own Discogs account and can't change your collection, wantlist, or anything else.</p>
        </div>
        <div class="feat-card">
          <h3>Slow first look — on purpose</h3>
          <p>The first analysis of an album takes about 10 seconds. Repeat questions are fast; results are cached briefly.</p>
        </div>
        <div class="feat-card">
          <h3>Free and open source</h3>
          <p>DIG is MIT-licensed, with no ads and no monetization. The whole engine is on GitHub.</p>
        </div>
        <div class="feat-card">
          <h3>Any Discogs user</h3>
          <p>Open access — one browser sign-in with your own Discogs account, no invite needed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 7 · MCP connector — Granola has one; ours IS one              -->
  <!-- ============================================================ -->
  <section class="section mcp">
    <div class="wrap mcp-card">
      <p class="eyebrow">DIG MCP connector</p>
      <h2>Use pressing intelligence anywhere</h2>
      <p class="mcp-copy">
        No more tab-hopping between listings and forums. Connect DIG in a few
        clicks and your AI apps become fluent in pressings — one URL, one
        browser sign-in with your own Discogs account.
      </p>
      <div class="mcp-code">
        <CodeBlock code={DIG.mcpUrl} label="MCP server URL" />
      </div>
      <p class="mcp-hint">
        Claude, ChatGPT, Codex, and more — <a href="/connect">step-by-step guides</a>
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- 8 · Product family (ours to keep) + closing CTA band          -->
  <!-- ============================================================ -->
  <section class="section" id="products">
    <div class="wrap products-head">
      <p class="eyebrow">The family</p>
      <h2>One brand, three tools</h2>
    </div>
    <div class="wrap">
      <div class="family-grid">
        <ProductCard
          token={DIG.token}
          catalog="WOIII·001"
          tint="green"
          description="Pressing intelligence for Discogs — in your AI assistant and your browser. Live now."
          href="/connect"
        />
        <ProductCard
          token={MIX.token}
          catalog="WOIII·002"
          tint="gold"
          badge={MIX.badge}
          description={MIX.description}
        />
        <ProductCard
          token={RIG.token}
          catalog="WOIII·003"
          tint="clay"
          badge={RIG.badge}
          description={RIG.description}
        />
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap">
      <div class="closing-card">
        <h2>Unlimited pressing verdicts, for&nbsp;free</h2>
        <p class="lede">Two minutes to connect. Any Discogs account, no invite needed.</p>
        <div class="hero-ctas">
          <a class="btn filled" href="/connect">Connect DIG for free</a>
          <a class="btn outlined" href={DIG.repoUrl}>View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ */
  /* 1 · Hero                                                      */
  /* ------------------------------------------------------------ */
  .hero {
    padding-top: calc(var(--space) * 15);
    text-align: center;
  }
  .hero h1 {
    max-width: 18ch;
    margin-inline: auto;
  }
  .hero-sub {
    margin: calc(var(--space) * 4) auto 0;
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 560;
    line-height: 1.35;
    color: var(--ink);
    letter-spacing: -0.015em;
  }
  .hero-ctas {
    display: flex;
    gap: calc(var(--space) * 2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: calc(var(--space) * 5);
  }
  .hero-avail {
    margin: calc(var(--space) * 2.5) auto 0;
    font-size: 0.875rem;
    color: var(--ink-tertiary);
  }

  .hero-demo-wrap {
    margin-top: calc(var(--space) * 9);
  }
  .hero-demo {
    position: relative;
    max-width: 620px;
    margin-inline: auto;
  }
  .window.big {
    max-width: none;
    box-shadow: var(--shadow-float);
    font-size: 1rem;
  }
  .float-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-high);
    border: 1px solid var(--line-soft);
    box-shadow: var(--shadow-soft);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-secondary);
    white-space: nowrap;
  }
  .fc-1 {
    top: 18%;
    left: -70px;
    transform: rotate(-3deg);
  }
  .fc-2 {
    bottom: 14%;
    right: -60px;
    transform: rotate(2deg);
  }
  .fc-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--grass);
  }
  @media (max-width: 860px) {
    .float-chip {
      display: none;
    }
  }

  .claims {
    list-style: none;
    padding: 0;
    margin: calc(var(--space) * 6) auto 0;
    display: flex;
    justify-content: center;
    gap: calc(var(--space) * 2) calc(var(--space) * 6);
    flex-wrap: wrap;
    max-width: 62rem;
  }
  .claims li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.9375rem;
    color: var(--ink-secondary);
  }
  .claims li::before {
    content: "✓";
    color: var(--grass);
    font-weight: 700;
  }
  .claims strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* ------------------------------------------------------------ */
  /* 2 · Wordmark wall                                             */
  /* ------------------------------------------------------------ */
  .wall {
    padding-block: calc(var(--space) * 11);
    text-align: center;
  }
  .wall-kicker {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--grass-deep);
  }
  .wall-title {
    font-size: 1.05rem;
    font-weight: 550;
    color: var(--ink-secondary);
    margin-top: calc(var(--space) * 1);
  }
  .wordmarks {
    list-style: none;
    padding: 0;
    margin: calc(var(--space) * 4) auto 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: calc(var(--space) * 3) calc(var(--space) * 7);
    flex-wrap: wrap;
  }
  .wordmarks li {
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink-faint);
  }

  /* ------------------------------------------------------------ */
  /* 3 · Tabbed journey                                            */
  /* ------------------------------------------------------------ */
  .journey-head {
    text-align: center;
    max-width: 22ch;
    margin-inline: auto;
  }

  .tab-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tab-bar {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin: calc(var(--space) * 5) auto calc(var(--space) * 6);
    background: var(--band);
    border-radius: 999px;
    padding: 5px;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
  }
  .tab-bar label {
    border-radius: 999px;
    padding: 9px 22px;
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--ink-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease-out, color 0.15s ease-out;
  }
  .tab-bar label:hover {
    color: var(--ink);
  }
  #tab-before:checked ~ .tab-bar label[for="tab-before"],
  #tab-during:checked ~ .tab-bar label[for="tab-during"],
  #tab-after:checked ~ .tab-bar label[for="tab-after"] {
    background: var(--surface-high);
    color: var(--ink);
    box-shadow: var(--shadow-soft);
  }
  .tab-radio:focus-visible ~ .tab-bar {
    outline: 2px solid var(--grass);
    outline-offset: 2px;
  }

  .tab-panel {
    display: none;
    grid-template-columns: 5fr 6fr;
    gap: calc(var(--space) * 8);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: calc(var(--radius-card) + 8px);
    box-shadow: var(--shadow-soft);
    padding: clamp(24px, 4vw, 56px);
  }
  #tab-before:checked ~ .tab-panels .panel-before,
  #tab-during:checked ~ .tab-panels .panel-during,
  #tab-after:checked ~ .tab-panels .panel-after {
    display: grid;
  }
  @media (max-width: 800px) {
    .tab-panel {
      grid-template-columns: 1fr;
      gap: calc(var(--space) * 4);
    }
  }
  .panel-copy h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    letter-spacing: -0.02em;
  }
  .panel-copy p {
    margin-top: calc(var(--space) * 2);
  }
  .honest-note {
    font-size: 0.9375rem;
    color: var(--ink-tertiary);
  }

  /* ------------------------------------------------------------ */
  /* Shared window artifact                                        */
  /* ------------------------------------------------------------ */
  .window {
    background: var(--surface-high);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-shot);
    box-shadow: var(--shadow-soft);
    max-width: 460px;
    margin-inline: auto;
    overflow: hidden;
    font-size: 0.9375rem;
    text-align: left;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 15px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--surface);
  }
  .window-dots {
    display: inline-flex;
    gap: 5px;
  }
  .window-dots i {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--canvas);
    border: 1px solid var(--line);
  }
  .window-title {
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--ink-tertiary);
    letter-spacing: 0.02em;
  }
  .window-body {
    padding: calc(var(--space) * 3);
  }
  .chat-q {
    background: var(--canvas);
    border: 1px solid var(--line-soft);
    border-radius: 16px 16px 5px 16px;
    padding: 10px 14px;
    font-weight: 550;
    margin-left: 16%;
    margin-bottom: calc(var(--space) * 2);
  }
  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.71rem;
    color: var(--ink-tertiary);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    margin-bottom: calc(var(--space) * 2);
  }
  .tool-glyph {
    color: var(--grass);
    font-style: normal;
  }
  .rank {
    display: flex;
    gap: 10px;
    margin-bottom: calc(var(--space) * 1.75);
    line-height: 1.45;
  }
  .rank-n {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--grass-tint);
    color: var(--grass-deep);
    font-size: 0.75rem;
    font-weight: 650;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }
  .rank-why {
    color: var(--ink-tertiary);
    font-size: 0.845rem;
  }
  .chat-meta {
    font-size: 0.75rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--line-soft);
