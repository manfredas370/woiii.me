---
import Base from "../layouts/Base.astro";
import ProductRing from "../components/ProductRing.astro";
import { DIG } from "../config/brand";
---

<Base
  title="WOIII.me — AI-powered tools for music lovers"
  description="Home of DIG for Discogs: pressing intelligence for your AI assistant and your browser. Which copy of this album should I buy? Answered with evidence, not folklore."
>
  <section class="landing-hero" aria-labelledby="hero-title">
    <div class="hero-copy edge-wrap">
      <h1 id="hero-title">
        Which <span class="accent">pressing</span> is actually worth <span class="accent">buying?</span>
      </h1>
      <div class="hero-actions" aria-label="DIG actions">
        <a class="site-button site-button-primary" href="/connect">Connect .DIG</a>
        <a class="site-button site-button-secondary" href={DIG.repoUrl} target="_blank" rel="noopener noreferrer">
          View on GitHub
        </a>
      </div>
    </div>

    <div class="hero-ring" aria-label="WOIII product family in motion">
      <ProductRing />
    </div>
  </section>

  <section class="manifesto" id="why-dig" aria-labelledby="manifesto-title">
    <div class="edge-wrap manifesto-inner">
      <h2 class="sr-only" id="manifesto-title">Evidence for better record buying</h2>
      <div class="manifesto-copy" data-scroll-text-reveal>
        <p>Record collecting is full of confident opinions.</p>
        <p aria-label="DIG adds the part that is usually missing: evidence.">
          <span class="manifesto-badge scroll-reveal-word" aria-hidden="true">
            <img src="/woiii-dig-badge.svg" alt="" width="136" height="30" />
          </span> adds the part that is usually missing: <em>evidence.</em>
        </p>
        <p>It compares the pressings, shows its coverage, and leaves the final call with you.</p>
      </div>
    </div>
  </section>

  <section class="journey" id="journey" aria-labelledby="journey-title">
    <div class="edge-wrap">
      <h2 id="journey-title">Before. During. <span class="accent">After.</span></h2>
      <div class="journey-grid">
        <article class="journey-card reveal">
          <span>Before you buy</span>
          <h3>Know which copy deserves your money.</h3>
          <p>Compare the pressings by sonics, collectibility, or value before the listing disappears.</p>
          <a href="/connect">Ask DIG</a>
        </article>
        <article class="journey-card reveal">
          <span>While you browse</span>
          <h3>See the score<br />beside the<br />listing.</h3>
          <p>Catch red flags and discover stronger alternatives without leaving discogs.com.</p>
          <a href="/connect#extension">Get the extension</a>
        </article>
        <article class="journey-card reveal">
          <span>After you add</span>
          <h3>Turn your shelf into a living memory.</h3>
          <p>Rank the wantlist, profile your taste, or ask what deserves a spin tonight.</p>
          <a href="/connect">Connect your collection</a>
        </article>
      </div>
    </div>
  </section>

  <section class="impact" id="impact" aria-labelledby="impact-title">
    <div class="edge-wrap">
      <h2 class="sr-only" id="impact-title">DIG by the numbers</h2>
      <dl class="impact-grid">
        <div>
          <dd><span>{DIG.toolCount}</span><sup>+</sup></dd>
          <dt>MCP tools for the record hunt</dt>
        </div>
        <div>
          <dd><span>{DIG.promptCount}</span><sup>+</sup></dd>
          <dt>Guided prompts and shortcuts</dt>
        </div>
        <div>
          <dd><span>0</span></dd>
          <dt>Trackers, ads, or data collection</dt>
        </div>
      </dl>
    </div>
  </section>

  <section class="products" id="products" aria-labelledby="products-title" data-header-tone="light">
    <div class="edge-wrap">
      <h2 id="products-title">Other products</h2>

      <div class="product-grid">
        <article class="product-art-card reveal">
          <img class="product-art-background" src="/products/mix-background.svg" alt="" width="500" height="500" loading="lazy" />
          <img class="product-art-dots" src="/products/dots.svg" alt="" width="452" height="452" loading="lazy" />
          <div class="product-art-content">
            <img class="product-art-logo" src="/products/mix-badge.svg" alt="WOIII.MIX" width="136" height="30" />
            <h3>A private mixtape<br />with a point of view</h3>
            <span class="product-coming-soon">Coming soon</span>
          </div>
        </article>
        <article class="product-art-card reveal">
          <img class="product-art-background" src="/products/rig-background.svg" alt="" width="500" height="500" loading="lazy" />
          <img class="product-art-dots" src="/products/dots.svg" alt="" width="452" height="452" loading="lazy" />
          <div class="product-art-content">
            <img class="product-art-logo" src="/products/rig-badge.svg" alt="WOIII.RIG" width="136" height="30" />
            <h3>Hi-fi gear matched<br />to how you listen</h3>
            <span class="product-coming-soon">Coming soon</span>
          </div>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(body) {
    --accent-hue: #c8ff9f;
  }

  :global(.site-header) {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border: 0 !important;
    box-shadow: none;
    background: transparent !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: background 220ms ease, backdrop-filter 220ms ease;
  }
  :global(.site-header.is-scrolled) {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.28) 0%,
      rgba(0, 0, 0, 0.16) 58%,
      rgba(0, 0, 0, 0) 100%
    ) !important;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  :global(.site-header.is-on-light.is-scrolled) {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.44) 0%,
      rgba(255, 255, 255, 0.22) 58%,
      rgba(255, 255, 255, 0) 100%
    ) !important;
  }
  :global(.site-header .wordmark img) {
    transition: filter 180ms ease;
  }
  :global(.site-header.is-on-light .wordmark img) {
    filter: invert(1);
  }
  :global(.site-header .wrap) {
    width: min(100%, 1440px);
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(24px, 3.35vw, 48px);
  }
  :global(.site-header .header-row nav) {
    gap: clamp(16px, 2vw, 30px);
  }
  :global(.site-header .header-row nav a) {
    display: inline-flex;
    align-items: center;
    min-height: auto;
    padding: 4px 0;
    border-radius: 0;
    color: rgba(255, 255, 255, 0.72) !important;
    background: transparent !important;
    font-size: 0.875rem;
    font-weight: 500 !important;
  }
  :global(.site-header .header-row nav a:hover),
  :global(.site-header .header-row nav a[aria-current="page"]) {
    color: #fff !important;
    background: transparent !important;
  }
  :global(.site-header.is-on-light .header-row nav a) {
    color: rgba(0, 0, 0, 0.68) !important;
  }
  :global(.site-header.is-on-light .header-row nav a:hover),
  :global(.site-header.is-on-light .header-row nav a[aria-current="page"]) {
    color: #000 !important;
  }
  :global(.site-footer) { margin-top: 0; }

  .edge-wrap {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding-inline: clamp(24px, 3.35vw, 48px);
  }
  .site-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 54px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #fff;
    font-family: "GT Standard", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .site-button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .site-button-primary { color: #fff; background: #8b94f2; }
  .site-button-primary:hover { background: #9aa2f5; }
  .site-button-secondary {
    border-color: rgba(255, 255, 255, 0.32);
    background: transparent;
  }
  .site-button-secondary:hover {
    border-color: rgba(255, 255, 255, 0.56);
    background: rgba(255, 255, 255, 0.08);
  }
  .site-button-dark { background: #080808; }
  .site-button-dark:hover { background: #272727; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .landing-hero {
    position: relative;
    min-height: 100svh;
    padding-top: 112px;
    overflow: hidden;
    background: #000;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .landing-hero h1 {
    max-width: 970px;
    margin: 58px auto 0;
    font-size: clamp(3.25rem, 7vw, 6.25rem);
    font-weight: 470;
    line-height: 1;
    letter-spacing: -0.02em;
    animation: hero-enter 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-summary {
    max-width: 670px;
    margin: 30px auto 0;
    color: #b9b9b2;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.55;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .text-link { color: #fff; text-decoration: none; font-weight: 600; }
  .text-link span { display: inline-block; margin-left: 5px; transition: transform 180ms ease; }
  .text-link:hover span { transform: translate(3px, -3px); }
  .hero-ring {
    position: absolute;
    z-index: 1;
    inset: auto 0 -74px;
  }

  .impact {
    padding: clamp(44px, 4vw, 56px) 0 clamp(80px, 8vw, 120px);
    background: #000;
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.15);
  }
  .impact-grid > div {
    padding: 54px clamp(20px, 4vw, 64px);
    text-align: center;
    background: #000;
  }
  .impact-grid dd {
    font-family: "GT Standard", sans-serif;
    font-size: clamp(4.5rem, 9vw, 8.5rem);
    font-weight: 430;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent-hue);
  }
  .impact-grid sup { font-size: 0.4em; vertical-align: top; }
  .impact-grid dt {
    max-width: 14rem;
    margin: 26px auto 0;
    color: #b8b8b2;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .manifesto {
    min-height: 1050px;
    padding-block: clamp(100px, 10vw, 150px);
    background: #000;
  }
  .manifesto-inner { position: relative; }
  .manifesto-copy {
    display: grid;
    gap: 0.32em;
    margin-top: 90px;
  }
  .manifesto-copy p {
    max-width: 1240px;
    font-family: "GT Standard", sans-serif;
    font-size: clamp(2.75rem, 5.25vw, 5rem);
    font-weight: 420;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .manifesto-copy em {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    color: var(--accent-hue);
  }
  :global(.manifesto-copy .scroll-reveal-word) {
    display: inline-block;
    opacity: 0.15;
    filter: blur(6px);
    will-change: opacity, filter;
  }
  .manifesto-copy .manifesto-badge {
    width: auto;
    height: 0.79em;
    line-height: 0;
    vertical-align: -0.09em;
  }
  .manifesto-badge img {
    display: block;
    width: auto;
    height: 100%;
  }
  .products {
    padding-block: clamp(90px, 7vw, 110px);
    color: #080808;
    background: #f7f7f4;
  }
  .products h2,
  .journey h2 {
    max-width: none;
    margin-bottom: 52px;
    font-size: clamp(3.2rem, 6vw, 5.3rem);
    font-weight: 440;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: center;
    width: 100%;
    margin-inline: auto;
    gap: 24px;
  }
  .product-art-card {
    --gradient-x: 0px;
    --gradient-y: 0px;
    --pointer-x: 50%;
    --pointer-y: 50%;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: clamp(28px, 3vw, 48px);
    background: #ecece8;
    transition: transform 240ms ease;
  }
  .product-art-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle at var(--pointer-x) var(--pointer-y),
      rgba(255, 255, 255, 0.42) 0%,
      rgba(255, 255, 255, 0.14) 18%,
      rgba(255, 255, 255, 0) 42%
    );
    mix-blend-mode: soft-light;
    transition: opacity 240ms ease;
  }
  .product-art-card:hover {
    transform: translateY(-6px);
  }
  .product-art-background {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate3d(var(--gradient-x), var(--gradient-y), 0) scale(1);
    transition: transform 180ms ease-out;
    will-change: transform;
  }
  @media (hover: hover) and (pointer: fine) {
    .product-art-card:hover::after,
    .product-art-card.is-pointer-active::after {
      opacity: 0.88;
    }
    .product-art-card:hover .product-art-background,
    .product-art-card.is-pointer-active .product-art-background {
      transform: translate3d(var(--gradient-x), var(--gradient-y), 0) scale(1.08);
    }
  }
  .product-art-dots {
    position: absolute;
    inset: 4.8%;
    display: block;
    width: 90.4%;
    height: 90.4%;
    z-index: 2;
  }
  .product-art-content {
    position: absolute;
    top: 31.6%;
    left: clamp(32px, 11.2%, 66px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 3;
  }
  .product-art-logo {
    display: block;
    width: auto;
    height: 36px;
  }
  .product-art-content h3 {
    margin-top: 40px;
    color: #fff;
    font-family: "GT Standard", sans-serif;
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    font-weight: 440;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .product-coming-soon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 20px;
    padding-inline: 22px;
    border: 1px solid rgba(42, 43, 48, 0.22);
    border-radius: 999px;
    color: #2a2b30;
    font-family: "GT Standard", sans-serif;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }
  .product-panel {
    --shift: 0px;
    position: relative;
    min-height: 690px;
    padding: clamp(24px, 3vw, 42px);
    border-radius: 48px;
    overflow: hidden;
    color: #080808;
    transform: translateY(var(--shift));
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 250ms ease;
  }
  .product-panel:hover { transform: translateY(calc(var(--shift) - 8px)); box-shadow: 0 30px 70px rgba(0, 0, 0, 0.12); }
  .dig-panel { background: #86ddf5; }
  .mix-panel { background: #d8f2aa; }
  .rig-panel {
    grid-column: 1 / -1;
    min-height: 620px;
    background: #c9c0ff;
  }
  .product-heading {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 28px;
    align-items: flex-start;
    justify-content: space-between;
  }
  .product-token { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.03em; }
  .product-heading h3 {
    max-width: 12ch;
    margin-top: 13px;
    font-size: clamp(2rem, 3.5vw, 3.35rem);
    font-weight: 520;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .panel-link,
  .status-chip {
    flex: none;
    padding: 10px 16px;
    border-radius: 999px;
    color: #080808;
    background: rgba(255, 255, 255, 0.28);
    font-size: 0.82rem;
    font-weight: 620;
    text-decoration: none;
  }
  .panel-link:hover { background: #fff; }
  .product-facts {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 22px;
    margin-top: 27px;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
  }
  .product-facts li::before { content: "•"; margin-right: 7px; }
  .product-description { margin-top: 26px; color: rgba(0, 0, 0, 0.65); line-height: 1.5; }
  .product-stage {
    position: absolute;
    inset: 38% 6% -6%;
    display: grid;
    place-items: center;
  }
  .assistant-window {
    width: min(100%, 570px);
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 24px;
    color: #f7f7f4;
    background: #101213;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
    transform: rotate(-2deg);
  }
  .assistant-bar,
  .rig-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #92968f;
    font-size: 0.72rem;
  }
  .assistant-brand { color: var(--accent-hue); font-weight: 750; }
  .assistant-query {
    margin: 20px 0;
    padding: 14px 16px;
    border-radius: 15px 15px 4px 15px;
    background: #202322;
    font-weight: 580;
  }
  .verdict {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 13px 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .verdict-rank { color: var(--accent-hue); font: 0.72rem ui-monospace, monospace; }
  .verdict strong { display: block; font-size: 0.88rem; }
  .verdict small { display: block; margin-top: 3px; color: #858983; font-size: 0.69rem; }
  .verdict b { color: var(--accent-hue); font-size: 1.35rem; }
  .verdict.muted { opacity: 0.7; }
  .evidence-line { margin: 12px 10px 3px; color: #6e736c; font-size: 0.67rem; }

  .mix-stage { perspective: 1000px; }
  .mixtape-card {
    position: absolute;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: min(72%, 400px);
    aspect-ratio: 4 / 5;
    padding: 26px;
    border-radius: 30px;
    color: #fff;
    background: #111;
    box-shadow: 0 26px 60px rgba(35, 52, 18, 0.25);
  }
  .mixtape-card.back { transform: translate(-24%, -12%) rotate(-10deg); background: #ff806e; }
  .mixtape-card.middle { transform: translate(20%, -7%) rotate(8deg); background: #5e57e7; }
  .mixtape-card.front { transform: rotate(-1deg); }
  .mixtape-card.front strong { font-family: "Instrument Serif", serif; font-size: clamp(2.8rem, 4.5vw, 4.2rem); font-weight: 400; line-height: 0.88; }
  .mix-label,
  .mixtape-card small { font-size: 0.7rem; line-height: 1.4; text-transform: uppercase; letter-spacing: 0.08em; }
  .mixtape-card small { color: #9c9c95; }

  .rig-stage { inset: 34% 8% -10%; }
  .rig-console {
    width: min(100%, 930px);
    padding: 25px;
    border-radius: 28px;
    color: #fff;
    background: #151419;
    box-shadow: 0 28px 70px rgba(33, 24, 74, 0.25);
    transform: rotate(1.5deg);
  }
  .rig-top { padding-bottom: 20px; border-bottom: 1px solid #2d2c33; }
  .rig-top b { color: #eee; }
  .rig-item {
    display: grid;
    grid-template-columns: 45px 1fr 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid #2d2c33;
  }
  .rig-item span { color: #a79cff; font: 0.78rem ui-monospace, monospace; }
  .rig-item em { color: #85828e; font-style: normal; }
  .rig-item b { color: #a79cff; font-size: 1.35rem; }
  .rig-meter { display: flex; gap: 8px; align-items: end; height: 70px; margin-top: 24px; }
  .rig-meter i { flex: 1; height: 34%; border-radius: 5px; background: #a79cff; }
  .rig-meter i:nth-child(2) { height: 60%; }
  .rig-meter i:nth-child(3) { height: 45%; }
  .rig-meter i:nth-child(4) { height: 82%; }
  .rig-meter i:nth-child(5) { height: 70%; }
  .rig-meter i:nth-child(6) { height: 100%; }
  .rig-meter i:nth-child(7) { height: 72%; }
  .journey {
    padding: clamp(96px, 8vw, 130px) 0 clamp(44px, 4vw, 56px);
    background: #000;
  }
  .journey-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .journey-card {
    display: flex;
    flex-direction: column;
    min-height: 390px;
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 32px;
    transition: border-color 180ms ease, transform 240ms ease;
  }
  .journey-card:hover { transform: translateY(-6px); border-color: var(--accent-hue); }
  .journey-card > span {
    color: var(--accent-hue);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .journey-card > span {
      opacity: 0;
      visibility: hidden;
      transform: translateY(4px);
    }
    .journey-card:hover > span,
    .journey-card:focus-within > span {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
