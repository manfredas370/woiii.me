---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductRing from "../components/ProductRing.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { DIG, MIX, RIG } from "../config/brand";
---

<Base
  title="WOIII.me — AI-powered tools for music lovers"
  description="Home of DIG for Discogs: pressing intelligence for your AI assistant and your browser. Which copy of this album should I buy? Answered with evidence, not folklore."
>
  <!-- Hero — one idea, lots of air, run-out grooves behind -->
  <section class="section hero">
    <div class="hero-grooves" aria-hidden="true"></div>
    <div class="wrap">
      <p class="kicker">
        <span class="kicker-token">woiii.DIG</span>
        <span class="kicker-live"><span class="kicker-dot"></span>live now</span>
      </p>
      <h1>
        Which <span class="accent">pressing</span> is actually worth&nbsp;buying?
      </h1>
      <p class="lede hero-lede">
        DIG for Discogs answers with evidence, not folklore — surveying every
        version of an album on Discogs and scoring each on community ratings,
        collector demand, and audiophile markers.
      </p>
      <div class="hero-ctas">
        <a class="btn filled" href="/connect">Connect DIG</a>
        <a class="btn outlined" href={DIG.repoUrl}>View on GitHub</a>
      </div>
      <p class="hero-fineprint">
        Free and open source · read-only · your own Discogs account · no ads,
        no data collection
      </p>
    </div>
  </section>

  <!-- Spotlight 1 — the assistant connector -->
  <section class="section">
    <div class="wrap spotlight">
      <div class="spotlight-copy">
        <p class="eyebrow">In your AI assistant</p>
        <h2 class="shiver">Ask, and get a <span class="accent">verdict</span></h2>
        <p>
          Connect DIG to Claude, ChatGPT, or Codex and ask about any album.
          It ranks the pressings with score breakdowns — original vs. reissue,
          MFSL and half-speed masters, renowned mastering engineers, Japanese
          pressings — and every verdict shows its evidence coverage.
        </p>
        <p class="honest-note">
          Honest caveat: the first analysis of an album takes about 10 seconds.
          Good answers are worth the wait.
        </p>
      </div>
      <div class="shot-card blue">
        <div class="window" role="img" aria-label="Example conversation: user asks which pressing of OK Computer to buy; the assistant calls the find_best_pressing tool and ranks three pressings with scores and evidence">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">Claude</span>
          </div>
          <div class="window-body chat">
            <p class="chat-q">What's the best-sounding pressing of OK Computer?</p>
            <p class="tool-chip"><span class="tool-glyph">⚙</span> find_best_pressing · axis: sonic</p>
            <div class="chat-a">
              <p class="rank"><span class="rank-n">1</span><span><strong>2016 XL 2×LP reissue</strong> — 92/100<br /><span class="rank-why">cut from the original masters · 4.6★ from 3k+ owners</span></span></p>
              <p class="rank"><span class="rank-n">2</span><span><strong>1997 UK first pressing</strong> — 88/100<br /><span class="rank-why">collector favourite, prices climbing</span></span></p>
              <p class="rank"><span class="rank-n">3</span><span><strong>2017 US repress</strong> — 79/100<br /><span class="rank-why">solid value pick</span></span></p>
              <p class="chat-meta">Evidence: 41 versions surveyed · community ratings + audiophile markers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Spotlight 2 — the side panel -->
  <section class="section">
    <div class="wrap spotlight reverse">
      <div class="spotlight-copy">
        <p class="eyebrow">In your browser</p>
        <h2 class="shiver">The same brain, on <span class="accent">discogs.com</span></h2>
        <p>
          The DIG side panel for Chrome shows pressing intelligence right next
          to the listing you're looking at — scores, red flags, and better
          alternatives while you browse or shop.
        </p>
        <p>
          <a href="/connect#extension">Install the extension →</a>
        </p>
      </div>
      <div class="shot-card green">
        <div class="window" role="img" aria-label="Example side panel: a release page with a DIG score of 84, three signals listed, and a suggestion of a better-rated pressing">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">DIG · discogs.com</span>
          </div>
          <div class="window-body panel">
            <p class="panel-title">This pressing <span class="panel-score">84</span></p>
            <ul class="panel-signals">
              <li><span class="sig ok">✓</span> Original mastering, well-rated (4.4★)</li>
              <li><span class="sig ok">✓</span> Sought by 1.2k collectors</li>
              <li><span class="sig warn">△</span> 2019 repress rates higher for playback</li>
            </ul>
            <p class="chat-meta">Based on 27 versions of this master</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest numbers -->
  <section class="section numbers">
    <div class="wrap">
      <dl class="numbers-row">
        <div>
          <dt>MCP tools</dt>
          <dd><span class="accent">{DIG.toolCount}</span></dd>
        </div>
        <div>
          <dt>Slash-command prompts</dt>
          <dd><span class="accent">{DIG.promptCount}</span></dd>
        </div>
        <div>
          <dt>REST endpoints</dt>
          <dd><span class="accent">{DIG.restEndpointCount}</span></dd>
        </div>
        <div>
          <dt>Trackers &amp; ads</dt>
          <dd><span class="accent">0</span></dd>
        </div>
      </dl>
      <p class="numbers-note">
        Scores are based on reputation and community data, not measured sound —
        and every verdict says how much evidence sits behind it.
      </p>
    </div>
  </section>

  <!-- Product family -->
  <section class="section" id="products">
    <div class="wrap products-head">
      <p class="eyebrow">The family</p>
      <h2 class="shiver">One brand, <span class="accent">three</span> tools</h2>
    </div>
    <div class="ring-holder">
      <ProductRing />
    </div>
    <div class="wrap">
      <div class="family-grid">
        <ProductCard
          token={DIG.token}
          catalog="WOIII·001"
          tint="blue"
          description="Pressing intelligence for Discogs — in your AI assistant and your browser. Live now."
          href="/connect"
        />
        <ProductCard
          token={MIX.token}
          catalog="WOIII·002"
          tint="green"
          badge={MIX.badge}
          description={MIX.description}
        />
        <ProductCard
          token={RIG.token}
          catalog="WOIII·003"
          tint="gold"
          badge={RIG.badge}
          description={RIG.description}
        />
      </div>
    </div>
  </section>


  <!-- Closing CTA -->
  <section class="section closing">
    <div class="wrap">
      <h2 class="shiver">Two minutes to <span class="accent">connect</span></h2>
      <p class="lede">One URL, any Discogs account, no invite needed.</p>
      <div class="closing-code">
        <CodeBlock code={DIG.mcpUrl} label="MCP server URL" />
      </div>
      <div class="hero-ctas">
        <a class="btn filled" href="/connect">Open the connect guide</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ */
  /* Hero                                                          */
  /* ------------------------------------------------------------ */
  .hero {
    position: relative;
    padding-block: calc(var(--space) * 17) calc(var(--space) * 15);
    text-align: center;
    overflow: hidden;
  }
  /* Run-out grooves — concentric hairlines rising behind the headline */
  .hero-grooves {
    position: absolute;
    inset: 0;
    background: repeating-radial-gradient(
      circle at 50% 130%,
      transparent 0 22px,
      rgba(33, 34, 39, 0.045) 22px 23px
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 12%, #000 60%);
    mask-image: linear-gradient(to bottom, transparent 12%, #000 60%);
    pointer-events: none;
  }
  .hero .wrap {
    position: relative;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--line);
    background: var(--canvas);
    border-radius: 999px;
    padding: 6px 14px 6px 8px;
    font-size: 0.8125rem;
    margin-bottom: calc(var(--space) * 4);
  }
  .kicker-token {
    background: var(--blue-tint);
    color: var(--blue-deep);
    font-weight: 650;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .kicker-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-secondary);
    font-weight: 520;
  }
  .kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--green-ink);
  }
  .hero h1 {
    max-width: 17ch;
    margin-inline: auto;
  }
  .hero-lede {
    margin-inline: auto;
    max-width: 37rem;
  }
  .hero-ctas {
    display: flex;
    gap: calc(var(--space) * 2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: calc(var(--space) * 5);
  }
  .hero-fineprint {
    margin: calc(var(--space) * 4) auto 0;
    font-size: 0.875rem;
    color: var(--ink-tertiary);
  }

  /* ------------------------------------------------------------ */
  /* Spotlights                                                    */
  /* ------------------------------------------------------------ */
  .spotlight {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: calc(var(--space) * 9);
    align-items: center;
  }
  .spotlight.reverse {
    grid-template-columns: 6fr 5fr;
  }
  .spotlight.reverse .spotlight-copy {
    order: 2;
  }
  @media (max-width: 800px) {
    .spotlight,
    .spotlight.reverse {
      grid-template-columns: 1fr;
      gap: calc(var(--space) * 5);
    }
    .spotlight.reverse .spotlight-copy {
      order: 0;
    }
  }
  .spotlight-copy p {
    margin-top: calc(var(--space) * 2);
  }
  .honest-note {
    font-size: 0.9375rem;
    color: var(--ink-tertiary);
  }

  /* ------------------------------------------------------------ */
  /* Product artifacts — mini windows on the tinted mats.          */
  /* The only shadowed elements in the system.                     */
  /* ------------------------------------------------------------ */
  .window {
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--radius-shot);
    box-shadow: var(--shadow-artifact);
    max-width: 460px;
    margin-inline: auto;
    overflow: hidden;
    font-size: 0.9375rem;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--surface);
  }
  .window-dots {
    display: inline-flex;
    gap: 5px;
  }
  .window-dots i {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--surface-inset);
    border: 1px solid var(--line);
  }
  .window-title {
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--ink-tertiary);
    letter-spacing: 0.02em;
  }
  .window-body {
    padding: calc(var(--space) * 2.5);
  }

  .chat-q {
    background: var(--surface-high);
    border-radius: 14px 14px 4px 14px;
    padding: 10px 14px;
    font-weight: 550;
    margin-left: 18%;
    margin-bottom: calc(var(--space) * 2);
  }
  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.71rem;
    color: var(--ink-tertiary);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    margin-bottom: calc(var(--space) * 2);
  }
  .tool-glyph {
    color: var(--blue-ink);
    font-style: normal;
  }
  .rank {
    display: flex;
    gap: 10px;
    margin-bottom: calc(var(--space) * 1.75);
    line-height: 1.45;
  }
  .rank-n {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--blue-tint);
    color: var(--blue-deep);
    font-size: 0.75rem;
    font-weight: 650;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }
  .rank-why {
    color: var(--ink-tertiary);
    font-size: 0.845rem;
  }
  .chat-meta {
    font-size: 0.75rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--line-soft);
    padding-top: calc(var(--space) * 1.5);
    margin-top: calc(var(--space) * 2);
  }

  .panel-title {
    font-weight: 650;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .panel-score {
    background: var(--green-tint);
    color: var(--green-ink);
    border: 1px solid color-mix(in srgb, var(--green-ink) 20%, transparent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    border-radius: 999px;
    padding: 3px 13px;
  }
  .panel-signals {
    list-style: none;
    padding: 0;
    margin-block: calc(var(--space) * 2);
    display: grid;
    gap: 10px;
  }
  .panel-signals li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    line-height: 1.45;
  }
  .sig {
    flex: none;
    font-size: 0.8rem;
    font-weight: 650;
  }
  .sig.ok {
    color: var(--green-ink);
  }
  .sig.warn {
    color: var(--gold-ink);
  }

  /* ------------------------------------------------------------ */
  /* Honest numbers                                                */
  /* ------------------------------------------------------------ */
  .numbers {
    background: var(--surface);
    border-block: 1px solid var(--line-soft);
  }
  .numbers-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    text-align: center;
  }
  .numbers-row > div {
    display: flex;
    flex-direction: column;
    padding-block: calc(var(--space) * 1);
  }
  .numbers-row > div + div {
    border-left: 1px solid var(--line);
  }
  @media (max-width: 720px) {
    .numbers-row {
      grid-template-columns: 1fr 1fr;
      row-gap: calc(var(--space) * 4);
    }
    .numbers-row > div:nth-child(3) {
      border-left: 0;
    }
  }
  .numbers-row dt {
    font-size: 0.8125rem;
    font-weight: 550;
    letter-spacing: 0.02em;
    color: var(--ink-tertiary);
    order: 2;
    margin-top: calc(var(--space) * 0.5);
  }
  .numbers-row dd {
    font-size: clamp(3rem, 6vw, 4.25rem);
    line-height: 1.05;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .numbers-note {
    text-align: center;
    margin: calc(var(--space) * 6) auto 0;
    color: var(--ink-tertiary);
    font-size: 0.9375rem;
    max-width: 40rem;
  }

  /* ------------------------------------------------------------ */
  /* Family grid + closing                                         */
  /* ------------------------------------------------------------ */
  .products-head {
    text-align: center;
  }
  .ring-holder {
    display: none;
    margin-top: calc(var(--space) * 6);
  }
  .family-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: calc(var(--space) * 3);
    margin-top: calc(var(--space) * 5);
  }
  /* wide screens: the wrapped ring replaces the static grid */
  @media (min-width: 900px) {
    .ring-holder {
      display: block;
    }
    .family-grid {
      display: none;
    }
  }

  .closing {
    text-align: center;
    background: var(--surface);
    border-top: 1px solid var(--line-soft);
    margin-top: calc(var(--space) * 6);
  }
  .closing .lede {
    margin-inline: auto;
  }
  .closing-code {
    max-width: 560px;
    margin: calc(var(--space) * 4) auto 0;
    text-align: left;
  }
  .closing :global(.codeblock) {
    background: var(--canvas);
  }
</style>
