---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductRing from "../components/ProductRing.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { DIG, MIX, RIG } from "../config/brand";
---

<Base
  title="WOIII.me — AI-powered tools for music lovers"
  description="Home of DIG for Discogs: pressing intelligence for your AI assistant and your browser. Which copy of this album should I buy? Answered with evidence, not folklore."
>
  <!-- Hero — one idea, lots of air, run-out grooves behind -->
  <section class="section hero">
    <div class="hero-grooves" aria-hidden="true"></div>
    <div class="wrap">
      <p class="kicker">
        <span class="kicker-token">woiii.DIG</span>
        <span class="kicker-live"><span class="kicker-dot"></span>live now</span>
      </p>
      <h1>
        Which <span class="accent">pressing</span> is actually worth&nbsp;buying?
      </h1>
      <p class="lede hero-lede">
        DIG for Discogs answers with evidence, not folklore — surveying every
        version of an album on Discogs and scoring each on community ratings,
        collector demand, and audiophile markers.
      </p>
      <div class="hero-ctas">
        <a class="btn filled" href="/connect">Connect DIG</a>
        <a class="btn outlined" href={DIG.repoUrl}>View on GitHub</a>
      </div>
      <p class="hero-fineprint">
        Free and open source · read-only · your own Discogs account · no ads,
        no data collection
      </p>
    </div>
  </section>

  <!-- Spotlight — the verdict, with floating status chips -->
  <section class="section">
    <div class="wrap spotlight">
      <div class="spotlight-copy">
        <p class="eyebrow">In your AI assistant</p>
        <h2 class="shiver">Ask, and get a <span class="accent">verdict</span></h2>
        <p>
          Connect DIG to Claude, ChatGPT, or Codex and ask about any album.
          It ranks the pressings with score breakdowns — original vs. reissue,
          MFSL and half-speed masters, renowned mastering engineers, Japanese
          pressings — and every verdict shows its evidence coverage.
        </p>
        <p class="honest-note">
          Honest caveat: the first analysis of an album takes about 10 seconds.
          Good answers are worth the wait.
        </p>
      </div>
      <div class="shot-card blue reveal">
        <div class="demo-float">
          <div class="window" role="img" aria-label="Example conversation: user asks which pressing of OK Computer to buy; the assistant calls the find_best_pressing tool and ranks three pressings with scores and evidence">
            <div class="window-bar">
              <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-title">Claude</span>
            </div>
            <div class="window-body chat">
              <p class="chat-q">What's the best-sounding pressing of OK Computer?</p>
              <p class="tool-chip"><span class="tool-glyph">⚙</span> find_best_pressing · axis: sonic</p>
              <div class="chat-a">
                <p class="rank"><span class="rank-n">1</span><span><strong>2016 XL 2×LP reissue</strong> — 92/100<br /><span class="rank-why">cut from the original masters · 4.6★ from 3k+ owners</span></span></p>
                <p class="rank"><span class="rank-n">2</span><span><strong>1997 UK first pressing</strong> — 88/100<br /><span class="rank-why">collector favourite, prices climbing</span></span></p>
                <p class="rank"><span class="rank-n">3</span><span><strong>2017 US repress</strong> — 79/100<br /><span class="rank-why">solid value pick</span></span></p>
                <p class="chat-meta">Evidence: 41 versions surveyed · community ratings + audiophile markers</p>
              </div>
            </div>
          </div>
          <div class="float-chip fc-1" aria-hidden="true"><span class="fc-dot"></span>Surveying 41 versions…</div>
          <div class="float-chip fc-2" aria-hidden="true">✓ Evidence coverage shown</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabbed journey — before / during / after the hunt -->
  <section class="section journey">
    <div class="wrap">
      <h2 class="shiver journey-head">
        Before, during and <span class="accent">after</span> the hunt
      </h2>

      <div class="tabs">
        <input class="tab-radio" type="radio" name="phase" id="tab-before" checked />
        <input class="tab-radio" type="radio" name="phase" id="tab-during" />
        <input class="tab-radio" type="radio" name="phase" id="tab-after" />

        <div class="tab-bar" role="tablist" aria-label="When DIG helps">
          <label for="tab-before">Before you buy</label>
          <label for="tab-during">While you browse</label>
          <label for="tab-after">After you add</label>
        </div>

        <div class="tab-panels reveal">
          <!-- BEFORE -->
          <div class="tab-panel panel-before">
            <div class="panel-copy">
              <h3>Know which copy is worth it</h3>
              <p>
                Compare pressings along the axis you care about — sonics,
                collectibility, or value — and see exactly why one copy beats
                another before money changes hands.
              </p>
            </div>
            <div class="panel-shot">
              <div class="window" role="img" aria-label="Assistant comparing two pressings by value with scores and reasons">
                <div class="window-bar">
                  <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="window-title">Claude</span>
                </div>
                <div class="window-body chat">
                  <p class="tool-chip"><span class="tool-glyph">⚙</span> compare_pressings · axis: value</p>
                  <div class="chat-a">
                    <p class="rank"><span class="rank-n">1</span><span><strong>2017 US repress</strong> — best value at ~€25<br /><span class="rank-why">96% of the sonics for a third of the price</span></span></p>
                    <p class="rank"><span class="rank-n">2</span><span><strong>2016 XL reissue</strong> — the safe pick<br /><span class="rank-why">widely available, consistently well-rated</span></span></p>
                    <p class="chat-meta">Evidence: prices + 3k community ratings</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- DURING -->
          <div class="tab-panel panel-during">
            <div class="panel-copy">
              <h3>Scores beside every listing</h3>
              <p>
                The DIG side panel for Chrome shows pressing intelligence right
                next to the listing you're looking at — scores, red flags, and
                better alternatives while you browse or shop on discogs.com.
              </p>
              <p><a href="/connect#extension">Install the extension →</a></p>
            </div>
            <div class="panel-shot">
              <div class="window" role="img" aria-label="Side panel showing a pressing score of 84 with three signals">
                <div class="window-bar">
                  <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="window-title">DIG · discogs.com</span>
                </div>
                <div class="window-body panel">
                  <p class="panel-title">This pressing <span class="panel-score">84</span></p>
                  <ul class="panel-signals">
                    <li><span class="sig ok">✓</span> Original mastering, well-rated (4.4★)</li>
                    <li><span class="sig ok">✓</span> Sought by 1.2k collectors</li>
                    <li><span class="sig warn">△</span> 2019 repress rates higher for playback</li>
                  </ul>
                  <p class="chat-meta">Based on 27 versions of this master</p>
                </div>
              </div>
            </div>
          </div>

          <!-- AFTER -->
          <div class="tab-panel panel-after">
            <div class="panel-copy">
              <h3>Your shelf, ranked and ready</h3>
              <p>
                DIG knows your collection and wantlist. Rank your wantlist by
                what's actually worth chasing, profile your taste, or get
                rating-weighted picks from records you already own.
              </p>
              <p class="honest-note">
                Slash commands in supported clients:
                <code>/rank-my-wantlist</code>, <code>/my-taste-profile</code>,
                <code>/pick-from-my-collection</code>.
              </p>
            </div>
            <div class="panel-shot">
              <div class="window" role="img" aria-label="Assistant ranking the user's wantlist by priority">
                <div class="window-bar">
                  <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                  <span class="window-title">Claude</span>
                </div>
                <div class="window-body chat">
                  <p class="tool-chip"><span class="tool-glyph">⚙</span> /rank-my-wantlist</p>
                  <div class="chat-a">
                    <p class="rank"><span class="rank-n">1</span><span><strong>In a Silent Way — 1969 US</strong><br /><span class="rank-why">prices climbing · rare in this grade</span></span></p>
                    <p class="rank"><span class="rank-n">2</span><span><strong>Kind of Blue — MFSL 2×45</strong><br /><span class="rank-why">strong sonics score, stable price</span></span></p>
                    <p class="chat-meta">Ranked 14 wantlist items by urgency</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Perfect collection memory -->
  <section class="section memory">
    <div class="wrap memory-grid">
      <div>
        <p class="eyebrow">DIG knows your shelf</p>
        <h2 class="shiver memory-head">
          Perfect <span class="accent">collection</span> memory
        </h2>
        <p class="memory-copy">
          Genre and decade breakdowns, a taste profile, recommendations that
          respect what you already own — all from your own Discogs account.
        </p>
      </div>
      <div class="memory-demo reveal">
        <p class="memory-q">What should I spin tonight?</p>
        <div class="window">
          <div class="window-bar">
            <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window-title">Claude</span>
          </div>
          <div class="window-body chat">
            <p class="tool-chip"><span class="tool-glyph">⚙</span> spin · mood: late night</p>
            <div class="chat-a">
              <p class="rank"><span class="rank-n">♪</span><span><strong>Talk Talk — Spirit of Eden</strong><br /><span class="rank-why">your 5★ shelf, unplayed for a while</span></span></p>
              <p class="rank"><span class="rank-n">♪</span><span><strong>Alice Coltrane — Journey in Satchidananda</strong><br /><span class="rank-why">fits the mood, rated 4.5★ by you</span></span></p>
              <p class="chat-meta">Picked from your own collection · rating-weighted</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest numbers -->
  <section class="section numbers">
    <div class="wrap">
      <dl class="numbers-row">
        <div>
          <dt>MCP tools</dt>
          <dd><span class="accent">{DIG.toolCount}</span></dd>
        </div>
        <div>
          <dt>Slash-command prompts</dt>
          <dd><span class="accent">{DIG.promptCount}</span></dd>
        </div>
        <div>
          <dt>REST endpoints</dt>
          <dd><span class="accent">{DIG.restEndpointCount}</span></dd>
        </div>
        <div>
          <dt>Trackers &amp; ads</dt>
          <dd><span class="accent">0</span></dd>
        </div>
      </dl>
      <p class="numbers-note">
        Scores are based on reputation and community data, not measured sound —
        and every verdict says how much evidence sits behind it.
      </p>
    </div>
  </section>

  <!-- Product family -->
  <section class="section" id="products">
    <div class="wrap products-head">
      <p class="eyebrow">The family</p>
      <h2 class="shiver">One brand, <span class="accent">three</span> tools</h2>
    </div>
    <div class="ring-holder">
      <ProductRing />
    </div>
    <div class="wrap">
      <div class="family-grid">
        <ProductCard
          token={DIG.token}
          catalog="WOIII·001"
          tint="blue"
          description="Pressing intelligence for Discogs — in your AI assistant and your browser. Live now."
          href="/connect"
        />
        <ProductCard
          token={MIX.token}
          catalog="WOIII·002"
          tint="green"
          badge={MIX.badge}
          description={MIX.description}
        />
        <ProductCard
          token={RIG.token}
          catalog="WOIII·003"
          tint="gold"
          badge={RIG.badge}
          description={RIG.description}
        />
      </div>
    </div>
  </section>

  <!-- Closing CTA — the lime pressing -->
  <section class="section closing">
    <div class="wrap">
      <div class="closing-card reveal">
        <h2 class="shiver">Two minutes to <span class="closing-serif">connect</span></h2>
        <p class="closing-lede">One URL, any Discogs account, no invite needed.</p>
        <div class="closing-code">
          <CodeBlock code={DIG.mcpUrl} label="MCP server URL" />
        </div>
        <div class="hero-ctas">
          <a class="btn closing-btn" href="/connect">Open the connect guide</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ */
  /* Hero                                                          */
  /* ------------------------------------------------------------ */
  .hero {
    position: relative;
    padding-block: calc(var(--space) * 17) calc(var(--space) * 15);
    text-align: center;
    overflow: hidden;
  }
  /* Run-out grooves — concentric hairlines rising behind the headline */
  .hero-grooves {
    position: absolute;
    inset: 0;
    background: repeating-radial-gradient(
      circle at 50% 130%,
      transparent 0 22px,
      rgba(255, 255, 255, 0.05) 22px 23px
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 12%, #000 60%);
    mask-image: linear-gradient(to bottom, transparent 12%, #000 60%);
    pointer-events: none;
  }
  .hero .wrap {
    position: relative;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    padding: 6px 14px 6px 8px;
    font-size: 0.8125rem;
    margin-bottom: calc(var(--space) * 4);
  }
  .kicker-token {
    background: var(--accent-tint);
    color: var(--accent-hue);
    font-weight: 650;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .kicker-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-secondary);
    font-weight: 520;
  }
  .kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent-hue);
  }
  .hero h1 {
    max-width: 17ch;
    margin-inline: auto;
  }
  .hero-lede {
    margin-inline: auto;
    max-width: 37rem;
  }
  .hero-ctas {
    display: flex;
    gap: calc(var(--space) * 2);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: calc(var(--space) * 5);
  }
  .hero-fineprint {
    margin: calc(var(--space) * 4) auto 0;
    font-size: 0.875rem;
    color: var(--ink-tertiary);
  }

  /* ------------------------------------------------------------ */
  /* Spotlight                                                     */
  /* ------------------------------------------------------------ */
  .spotlight {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: calc(var(--space) * 9);
    align-items: center;
  }
  @media (max-width: 800px) {
    .spotlight {
      grid-template-columns: 1fr;
      gap: calc(var(--space) * 5);
    }
  }
  .spotlight-copy p {
    margin-top: calc(var(--space) * 2);
  }
  .honest-note {
    font-size: 0.9375rem;
    color: var(--ink-tertiary);
  }

  .demo-float {
    position: relative;
  }
  .float-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-high);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-secondary);
    white-space: nowrap;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.7);
  }
  .fc-1 {
    top: 12%;
    left: -34px;
    transform: rotate(-3deg);
  }
  .fc-2 {
    bottom: 10%;
    right: -26px;
    transform: rotate(2deg);
  }
  .fc-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent-hue);
  }
  @media (max-width: 1100px) {
    .float-chip {
      display: none;
    }
  }

  /* ------------------------------------------------------------ */
  /* Product artifacts — mini windows on deep label mats.          */
  /* ------------------------------------------------------------ */
  .window {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-shot);
    box-shadow: var(--shadow-artifact);
    max-width: 460px;
    margin-inline: auto;
    overflow: hidden;
    font-size: 0.9375rem;
    text-align: left;
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line-soft);
    background: var(--surface-high);
  }
  .window-dots {
    display: inline-flex;
    gap: 5px;
  }
  .window-dots i {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--surface-inset);
    border: 1px solid var(--line);
  }
  .window-title {
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--ink-tertiary);
    letter-spacing: 0.02em;
  }
  .window-body {
    padding: calc(var(--space) * 2.5);
  }

  .chat-q {
    background: var(--surface-high);
    border-radius: 14px 14px 4px 14px;
    padding: 10px 14px;
    font-weight: 550;
    margin-left: 15%;
    margin-bottom: calc(var(--space) * 2);
  }
  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.71rem;
    color: var(--ink-tertiary);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 10px;
    margin-bottom: calc(var(--space) * 2);
  }
  .tool-glyph {
    color: var(--accent-hue);
    font-style: normal;
  }
  .rank {
    display: flex;
    gap: 10px;
    margin-bottom: calc(var(--space) * 1.75);
    line-height: 1.45;
  }
  .rank-n {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent-hue);
    font-size: 0.75rem;
    font-weight: 650;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }
  .rank-why {
    color: var(--ink-tertiary);
    font-size: 0.845rem;
  }
  .chat-meta {
    font-size: 0.75rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--line-soft);
    padding-top: calc(var(--space) * 1.5);
    margin-top: calc(var(--space) * 2);
  }

  .panel-title {
    font-weight: 650;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .panel-score {
    background: var(--green-tint);
    color: var(--green-ink);
    border: 1px solid color-mix(in srgb, var(--green-ink) 30%, transparent);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    border-radius: 999px;
    padding: 3px 13px;
  }
  .panel-signals {
    list-style: none;
    padding: 0;
    margin-block: calc(var(--space) * 2);
    display: grid;
    gap: 10px;
  }
  .panel-signals li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    line-height: 1.45;
  }
  .sig {
    flex: none;
    font-size: 0.8rem;
    font-weight: 650;
  }
  .sig.ok {
    color: var(--green-ink);
  }
  .sig.warn {
    color: var(--gold-ink);
  }

  /* ------------------------------------------------------------ */
  /* Tabbed journey                                                */
  /* ------------------------------------------------------------ */
  .journey-head {
    text-align: center;
    max-width: 24ch;
    margin-inline: auto;
  }
  .tab-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tab-bar {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin: calc(var(--space) * 5) auto calc(var(--space) * 6);
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    padding: 5px;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
  }
  .tab-bar label {
    border-radius: 999px;
    padding: 9px 22px;
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--ink-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease-out, color 0.15s ease-out;
  }
  .tab-bar label:hover {
    color: var(--ink);
  }
  #tab-before:checked ~ .tab-bar label[for="tab-before"],
  #tab-during:checked ~ .tab-bar label[for="tab-during"],
  #tab-after:checked ~ .tab-bar label[for="tab-after"] {
    background: var(--accent-hue);
    color: var(--on-accent);
  }
  .tab-radio:focus-visible ~ .tab-bar {
    outline: 2px solid var(--accent-hue);
    outline-offset: 2px;
  }

  .tab-panel {
    display: none;
    grid-template-columns: 5fr 6fr;
    gap: calc(var(--space) * 8);
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: calc(var(--radius-card) + 8px);
    padding: clamp(24px, 4vw, 56px);
  }
  #tab-before:checked ~ .tab-panels .panel-before,
  #tab-during:checked ~ .tab-panels .panel-during,
  #tab-after:checked ~ .tab-panels .panel-after {
    display: grid;
  }
  @media (max-width: 800px) {
    .tab-panel {
      grid-template-columns: 1fr;
      gap: calc(var(--space) * 4);
    }
  }
  .panel-copy h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    letter-spacing: -0.02em;
  }
  .panel-copy p {
    margin-top: calc(var(--space) * 2);
  }
  .tab-panel .window {
    background: var(--surface-high);
  }
  .tab-panel .window-bar {
    background: var(--surface-inset);
  }
  .tab-panel .chat-q {
    background: var(--surface-inset);
  }

  /* ------------------------------------------------------------ */
  /* Perfect collection memory                                     */
  /* ------------------------------------------------------------ */
  .memory-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--space) * 8);
    align-items: center;
  }
  @media (max-width: 800px) {
    .memory-grid {
      grid-template-columns: 1fr;
    }
  }
  .memory-head {
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
  }
  .memory-copy {
    margin-top: calc(var(--space) * 3);
    color: var(--ink-secondary);
  }
  .memory-q {
    display: inline-block;
    background: var(--surface-high);
    border: 1px solid var(--line);
    border-radius: 18px 18px 5px 18px;
    padding: 12px 18px;
    font-weight: 560;
    margin-bottom: calc(var(--space) * 2.5);
    transform: rotate(-1deg);
  }

  /* ------------------------------------------------------------ */
  /* Honest numbers                                                */
  /* ------------------------------------------------------------ */
  .numbers {
